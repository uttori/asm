{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Uttori Assembly",
  "scopeName": "source.uttori-asm",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#directives" },
    { "include": "#numbers" },
    { "include": "#labels" },
    { "include": "#defines" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.semicolon.uttori-asm", "match": ";.*$" }]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.uttori-asm",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.uttori-asm", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.uttori-asm",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.uttori-asm", "match": "\\\\." }]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.uttori-asm",
          "match": "(?i)(?<![A-Za-z0-9_])[.@][A-Za-z_][A-Za-z0-9_.]*(?![A-Za-z0-9_.])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.uttori-asm", "match": "(\\$|0x)[0-9A-Fa-f]+" },
        { "name": "constant.numeric.binary.uttori-asm", "match": "(%|0b)[01]+" },
        {
          "name": "constant.numeric.decimal.uttori-asm",
          "match": "(?<![A-Za-z0-9_.])[0-9]+"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.function.label.uttori-asm",
          "match": "^\\s*[A-Za-z_.][A-Za-z0-9_.]*:"
        },
        { "name": "entity.name.function.label.local.uttori-asm", "match": "^\\s*[-+]+" }
      ]
    },
    "defines": {
      "patterns": [{ "name": "variable.other.define.uttori-asm", "match": "!\\w+" }]
    }
  }
}
