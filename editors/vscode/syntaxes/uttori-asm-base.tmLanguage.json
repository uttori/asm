{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Uttori Assembly Base",
  "scopeName": "source.uttori-asm.base",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#labels" },
    { "include": "#numbers" },
    { "include": "#mnemonics" },
    { "include": "#size-suffixes" },
    { "include": "#macros" },
    { "include": "#pseudo-ops" },
    { "include": "#defines" },
    { "include": "#struct-access" },
    { "include": "#immediate-labels" },
    { "include": "#local-label-refs" },
    { "include": "#directives" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.semicolon.uttori-asm", "match": ";.*$" }]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.uttori-asm",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.uttori-asm", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.uttori-asm",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.uttori-asm", "match": "\\\\." }]
        }
      ]
    },
    "mnemonics": {
      "patterns": [
        {
          "name": "keyword.mnemonic.6502.uttori-asm",
          "match": "\\b(?i:ADC|AND|ASL|BCC|BCS|BEQ|BIT|BMI|BNE|BPL|BRK|BVC|BVS|CLC|CLD|CLI|CLV|CMP|CPX|CPY|DEC|DEX|DEY|EOR|INC|INX|INY|JMP|JSR|LDA|LDX|LDY|LSR|NOP|ORA|PHA|PHP|PLA|PLP|ROL|ROR|RTI|RTS|SBC|SEC|SED|SEI|STA|STX|STY|TAX|TAY|TSX|TXA|TXS|TYA)\\b"
        },
        {
          "name": "keyword.mnemonic.65c02.uttori-asm",
          "match": "\\b(?i:BRA|PHX|PHY|PLX|PLY|STP|STZ|TRB|TSB|WAI)\\b"
        },
        {
          "name": "keyword.mnemonic.65c02.uttori-asm",
          "match": "\\b(?i:(BBR|BBS|RMB|SMB)[0-7])\\b"
        },
        {
          "name": "keyword.mnemonic.65816.uttori-asm",
          "match": "\\b(?i:BRL|COP|JML|JSL|MVN|MVP|PEA|PEI|PER|PHB|PHD|PHK|PLB|PLD|REP|RTL|SEP|TCD|TCS|TDC|TSC|TXY|TYX|WDM|XBA|XCE)\\b"
        },
        {
          "name": "keyword.mnemonic.65816l.uttori-asm",
          "match": "\\b(?i:ADCL|ANDL|CMPL|EORL|LDAL|ORAL|SBCL|STAL)\\b"
        },
        {
          "name": "keyword.mnemonic.65816alt.uttori-asm",
          "match": "\\b(?i:BGE|BLT|CPA|DEA|INA|SWA|TAD|TAS|TDA|TSA)\\b"
        }
      ]
    },
    "size-suffixes": {
      "patterns": [
        {
          "name": "storage.modifier.size.uttori-asm",
          "match": "(?<=[A-Za-z0-9_])\\.(?i:b|w|l)\\b"
        }
      ]
    },
    "pseudo-ops": {
      "patterns": [
        {
          "match": "\\b(?i:(arch))\\s+(?i:(spc700-inline|spc700-raw|spc700|65816|superfx))\\b",
          "captures": {
            "1": { "name": "support.function.pseudo.uttori-asm" },
            "2": { "name": "constant.language.uttori-asm" }
          }
        },
        {
          "match": "\\b(?i:(base))\\s+(?i:(off))\\b",
          "captures": {
            "1": { "name": "support.function.pseudo.uttori-asm" },
            "2": { "name": "constant.language.uttori-asm" }
          }
        },
        {
          "match": "\\b(?i:table)\\b[^;]*\\b(?i:(ltr|rtl))\\b",
          "captures": {
            "1": { "name": "constant.language.uttori-asm" }
          }
        },
        {
          "match": "\\b(?i:(namespace))\\s+(?i:(nested))\\s+(?i:(on|off))\\b",
          "captures": {
            "1": { "name": "keyword.directive.namespace.uttori-asm" },
            "2": { "name": "keyword.directive.operand.uttori-asm" },
            "3": { "name": "constant.language.uttori-asm" }
          }
        },
        {
          "match": "\\b(?i:(namespace))\\s+(?i:(off))\\b",
          "captures": {
            "1": { "name": "keyword.directive.namespace.uttori-asm" },
            "2": { "name": "constant.language.uttori-asm" }
          }
        },
        {
          "match": "\\b(?i:struct)\\s+[A-Za-z_][A-Za-z0-9_]*\\s+(?i:(extends))\\b",
          "captures": {
            "1": { "name": "keyword.directive.operand.uttori-asm" }
          }
        },
        {
          "match": "\\b(?i:(endstruct))\\s+(?i:(align))\\b",
          "captures": {
            "1": { "name": "keyword.directive.struct.uttori-asm" },
            "2": { "name": "keyword.directive.operand.uttori-asm" }
          }
        },
        {
          "name": "support.function.pseudo.uttori-asm",
          "match": "\\b(?i:db|dw|dl|dd|dc\\.b|dc\\.w|dc\\.l|org|base|bank|skip|fillbyte|fillword|filllong|filldword|fill|padbyte|padword|padlong|paddword|pad|incbin|incsrc|include|includeonce|pushpc|pullpc|pushbase|pullbase|table|cleartable|pushtable|pulltable|arch|function|undef|global)\\b"
        },
        {
          "name": "keyword.control.conditional.uttori-asm",
          "match": "\\b(?i:if|elseif|else|endif|while|endwhile|for|endfor)\\b"
        },
        {
          "name": "keyword.directive.macro.uttori-asm",
          "match": "\\b(?i:macro|endmacro)\\b"
        },
        {
          "match": "\\b((?i:namespace))\\s+(?:(?i:nested)\\s+(?i:on|off)|(?i:off)|([A-Za-z_][A-Za-z0-9_]*))",
          "captures": {
            "1": { "name": "keyword.directive.namespace.uttori-asm" },
            "2": { "name": "entity.name.namespace.uttori-asm" }
          }
        },
        {
          "name": "keyword.directive.namespace.uttori-asm",
          "match": "\\b(?i:namespace|pushns|pullns)\\b"
        },
        {
          "match": "\\b(?i:struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "0": { "name": "keyword.directive.struct.uttori-asm" },
            "1": { "name": "entity.name.type.struct.uttori-asm" }
          }
        },
        {
          "name": "keyword.directive.struct.uttori-asm",
          "match": "\\b(?i:struct|endstruct|extends|align)\\b"
        },
        {
          "name": "keyword.control.diagnostic.uttori-asm",
          "match": "\\b(?i:assert|error|warnpc|print|warn)\\b"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.uttori-asm",
          "match": "(?i)(?<![A-Za-z0-9_])[.@][A-Za-z_][A-Za-z0-9_.]*(?![A-Za-z0-9_.:])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.uttori-asm",
          "match": "#?(\\$|0x)[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.binary.uttori-asm",
          "match": "#?(%|0b)[01]+"
        },
        {
          "name": "constant.numeric.char.uttori-asm",
          "match": "#'[^']'"
        },
        {
          "name": "constant.numeric.decimal.uttori-asm",
          "match": "#?(?<![A-Za-z0-9_.])[0-9]+"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "^\\s*(\\.{1,})([A-Za-z_][A-Za-z0-9_]*)\\s*:",
          "captures": {
            "1": { "name": "punctuation.definition.label.uttori-asm" },
            "2": { "name": "entity.name.label.local.uttori-asm" }
          }
        },
        {
          "name": "entity.name.function.label.uttori-asm",
          "match": "^\\s*[A-Za-z_][A-Za-z0-9_]*:"
        },
        { "name": "entity.name.function.label.local.uttori-asm", "match": "^\\s*[-+]+" }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "entity.name.function.macro.uttori-asm",
          "match": "%[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "defines": {
      "patterns": [
        {
          "name": "variable.other.define.uttori-asm",
          "match": "!\\{[A-Za-z0-9_]+\\}"
        },
        {
          "name": "variable.other.define.uttori-asm",
          "match": "!\\w+"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.expression.uttori-asm",
          "match": "\\b(?i:sizeof|objectsize|datasize|defined|stringsequal|stringsequalnocase)\\b"
        }
      ]
    },
    "struct-access": {
      "patterns": [
        {
          "name": "meta.struct-access.uttori-asm",
          "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\[|\\.(?!(?i:b|w|l|asm|inc|bin|src|s)\\b))",
          "beginCaptures": {
            "1": { "name": "entity.name.type.struct.uttori-asm" }
          },
          "end": "(?![.\\[A-Za-z0-9_])",
          "patterns": [
            {
              "match": "\\[([^\\]]*)\\]",
              "name": "meta.indexer.uttori-asm",
              "captures": {
                "1": {
                  "patterns": [{ "include": "#numbers" }, { "include": "#defines" }]
                }
              }
            },
            {
              "match": "\\.([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": { "name": "variable.other.member.uttori-asm" }
              }
            }
          ]
        },
        {
          "match": "(?<=[\\w}\\]])\\.((?!(?i:b|w|l)\\b)[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "variable.other.member.uttori-asm" }
          }
        }
      ]
    },
    "immediate-labels": {
      "patterns": [
        {
          "match": "#([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.label.uttori-asm" }
          }
        }
      ]
    },
    "local-label-refs": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_])(\\.{1,})([A-Za-z0-9_]+)",
          "captures": {
            "1": { "name": "punctuation.definition.label.uttori-asm" },
            "2": { "name": "entity.name.label.local.uttori-asm" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.uttori-asm",
          "match": "[-+/*^><|#\\[\\]()=.!&]"
        }
      ]
    }
  }
}
