{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SNES Assembly",
  "scopeName": "source.snes-asm",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#directives" },
    { "include": "#controlflow" },
    { "include": "#instructions" },
    { "include": "#registers" },
    { "include": "#numbers" },
    { "include": "#labels" },
    { "include": "#defines" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.semicolon.snes-asm", "match": ";.*$" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.snes-asm", "begin": "\"", "end": "\"" },
        { "name": "string.quoted.single.snes-asm", "begin": "'", "end": "'" }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.snes-asm",
          "match": "(?i)(?<![A-Za-z0-9_.])(db|dw|dl|dd|dc\\.[bwl]|fillbyte|fillword|filllong|filldword|fill|padbyte|padword|padlong|paddword|pad|incsrc|include|includeonce|incbin|base|org|pushbase|pullbase|pushpc|pullpc|startpos|check|optimize|arch|lorom|hirom|exlorom|exhirom|fastrom|sfxrom|norom|sa1rom|fullsa1rom|namespace|pushns|pullns|freecode|freedata|freespace|freespacebyte|prot|pushtable|pulltable|spcblock|endspcblock|struct|endstruct|macro|endmacro|dpbase|warnings|print|autoclean|autoclear|table|includefrom|asar)(?![A-Za-z0-9_.])"
        }
      ]
    },
    "controlflow": {
      "patterns": [
        {
          "name": "keyword.control.flow.snes-asm",
          "match": "(?i)(?<![A-Za-z0-9_.])(if|elseif|else|endif|while|endwhile|for|endfor)(?![A-Za-z0-9_.])"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "keyword.operator.instruction.snes-asm",
          "match": "(?i)(?<![A-Za-z0-9_.])(ADC|AND|ASL|BCC|BCS|BEQ|BIT|BMI|BNE|BPL|BRA|BRK|BRL|BVC|BVS|CLC|CLD|CLI|CLV|CMP|COP|CPX|CPY|DEC|DEX|DEY|EOR|INC|INX|INY|JML|JMP|JSL|JSR|LDA|LDX|LDY|LSR|MVN|MVP|NOP|ORA|PEA|PEI|PER|PHA|PHB|PHD|PHK|PHP|PHX|PHY|PLA|PLB|PLD|PLP|PLX|PLY|REP|ROL|ROR|RTI|RTL|RTS|SBC|SEC|SED|SEI|SEP|STA|STP|STX|STY|STZ|TAX|TAY|TCD|TCS|TDC|TSC|TSX|TXA|TXS|TXY|TYA|TYX|WAI|WDM|XBA|XCE|MOV|CALL|RET|RETI|CBNE|DBNZ|CLRC|SETC|CLRP|SETP|MULT|RPIX)(?![A-Za-z0-9_.])"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.snes-asm",
          "match": "(?i)(?<![A-Za-z0-9_.])(A|X|Y|S|SP|PC|DP|DB|PB)(?![A-Za-z0-9_.])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.snes-asm", "match": "(\\$|0x)[0-9A-Fa-f]+" },
        { "name": "constant.numeric.binary.snes-asm", "match": "%[01]+" },
        { "name": "constant.numeric.decimal.snes-asm", "match": "(?<![A-Za-z0-9_.])[0-9]+" }
      ]
    },
    "labels": {
      "patterns": [
        { "name": "entity.name.function.label.snes-asm", "match": "^\\s*[A-Za-z_.][A-Za-z0-9_.]*:" },
        { "name": "entity.name.function.label.local.snes-asm", "match": "^\\s*[-+]+" }
      ]
    },
    "defines": {
      "patterns": [
        { "name": "variable.other.define.snes-asm", "match": "!\\w+" }
      ]
    }
  }
}
