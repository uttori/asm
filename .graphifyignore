# Only index assembler and package source.
# gitignore last-match-wins: deny the repo, then re-include the source trees.
/*
!/packages/
!/packages/**
!/tests/
!/tests/**

# Built / bundled artifacts and IDE scaffolding inside those trees
packages/vscode-extension/out/
packages/vscode-extension/server/
packages/vscode-extension/.vscode/
packages/vscode-extension/*.vsix
packages/language-server/out/

# General Ignore
node_modules/
graphify-out/
.pnpm-store/
coverage/
*.min.js
*.min.css
*.map
pnpm-lock.yaml
yarn.lock
*.lock
*.log
.env*
