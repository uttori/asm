-configuration.json ./packages/vscode-extension/syntaxes ./packages/vscode-extension/snippets/uttori-asm.json ./tests ./packages/core/tests ./packages/language-server/tests ./packages/vscode-extension/tests ./packages/disassembler/tests ./packages/plugin-loader-node/tests ./packages/plugin-snes/tests/disassembler ./packages/plugin-snes/tests/65816-decoder.test.ts ./packages/plugin-snes/tests/assembler.test.ts ./.oxlintrc.json ./tsconfig.json ./packages/vscode-extension/media ./packages/plugin-65xx/demo ./scripts/research ./packages/workflows/src ./packages/workflows/package.json ./packages/workflows/tsconfig.json ./packages/capture/src ./packages/capture/package.json ./packages/capture/tsconfig.json ./packages/game-secret-of-mana/src ./packages/game-secret-of-mana/package.json ./packages/game-secret-of-mana/tsconfig.json ./packages/workflows/tests ./scripts/inventory-package-api.ts ./scripts/benchmark-package-contracts.ts ./packages/capture/tests ./scripts/runtime-bundles.mjs ./scripts/check-runtime-bundles.mjs ./scripts/benchmark-source-export.ts ./scripts/benchmark-toolchain.ts ./scripts/benchmark-paused-runtime.ts ./packages/plugin-65xx/tests ./scripts/benchmark-asset-memory.ts",
    "fmt": "oxfmt ./packages/assets/src ./packages/assets/examples ./scripts/generate-asset-phase1-fixtures.ts ./packages/assets/tests ./packages/assets/package.json ./packages/assets/tsconfig.json ./packages/assets/tsconfig.build.json ./packages/assets/README.md ./packages/disassembler/src ./packages/disassembler/package.json ./packages/disassembler/tsconfig.json ./packages/disassembler/README.md ./packages/cli/src ./packages/cli/tests ./packages/cli/esbuild.mjs ./packages/cli/package.json ./packages/cli/tsconfig.json ./packages/cli/README.md ./packages/core/src ./packages/plugin-loader-node/src ./packages/plugin-loader-node/package.json ./packages/plugin-loader-node/tsconfig.json ./packages/plugin-loader-node/asm-config.schema.json ./packages/plugin-snes/src ./packages/plugin-snes/package.json ./packages/plugin-snes/tsconfig.json ./packages/plugin-snes/tsconfig.build.json ./packages/plugin-65xx/src ./packages/plugin-65xx/package.json ./packages/plugin-65xx/tsconfig.json ./scripts/benchmark-disassembler.ts ./scripts/benchmark-report.ts ./scripts/disassembler-benchmark-budget.ts ./scripts/derive-disassembler-budgets.ts ./scripts/check-framework-spc700-oracle.ts ./scripts/generate-65xx-variant-tables.ts ./scripts/run-asar-fixtures.ts ./scripts/run-slideshow.ts ./scripts/run-chou.ts ./scripts/external-fixtures.ts ./scripts/fixtures-status.ts ./scripts/ci-external.ts ./scripts/extract-smrpg-assets.ts ./scripts/extract-tmnt-assets.ts ./scripts/place-snes-rom-framework.ts ./scripts/diff.ts ./fixtures/fixture-manifest.ts ./scripts/smoke-language-server-bundle.ts ./scripts/check-package-tarballs.ts ./packages/plugin-author ./packages/language-server/src ./packages/language-server/esbuild.mjs ./packages/language-server/package.json ./packages/language-server/tsconfig.json ./packages/vscode-extension/src ./packages/vscode-extension/esbuild.mjs ./packages/vscode-extension/package.json ./packages/vscode-extension/tsconfig.json ./packages/vscode-extension/language-configuration.json ./packages/vscode-extension/syntaxes ./packages/vscode-extension/snippets/uttori-asm.json ./tests ./packages/core/tests ./packages/language-server/tests ./packages/vscode-extension/tests ./packages/disassembler/tests ./packages/plugin-loader-node/tests ./packages/plugin-snes/tests/disassembler ./packages/plugin-snes/tests/65816-decoder.test.ts ./packages/plugin-snes/tests/assembler.test.ts ./.oxlintrc.json ./tsconfig.json ./packages/vscode-extension/media ./packages/plugin-65xx/demo ./scripts/research ./packages/workflows/src ./packages/workflows/package.json ./packages/workflows/tsconfig.json ./packages/capture/src ./packages/capture/package.json ./packages/capture/tsconfig.json ./packages/game-secret-of-mana/src ./packages/game-secret-of-mana/package.json ./packages/game-secret-of-mana/tsconfig.json ./packages/workflows/tests ./scripts/inventory-package-api.ts ./scripts/benchmark-package-contracts.ts ./packages/capture/tests ./scripts/runtime-bundles.mjs ./scripts/check-runtime-bundles.mjs ./scripts/benchmark-source-export.ts ./scripts/benchmark-toolchain.ts ./scripts/benchmark-paused-runtime.ts ./packages/plugin-65xx/tests ./scripts/benchmark-asset-memory.ts",
