    "pack:check": "node --conditions=uttori-source --import=tsx scripts/check-package-tarballs.ts",
    "prefmt:check": "oxfmt --check ./README.md ./CONTRIBUTING.md ./SECURITY.md ./packages/disassembler/ARCHITECTURE.md ./TESTING.md ./packages/debug-adapter/src ./packages/debug-adapter/tests ./packages/debug-adapter/package.json ./packages/debug-adapter/tsconfig.json ./packages/debug-adapter/README.md ./packages/debug-sidecar-ares/src ./packages/debug-sidecar-ares/tests ./packages/debug-sidecar-ares/esbuild.mjs ./packages/debug-sidecar-ares/package.json ./packages/debug-sidecar-ares/tsconfig.json ./packages/debug-sidecar-ares/README.md ./packages/vscode-extension/tests-host ./scripts/check-documentation.ts ./scripts/clean-workspace-build.ts ./scripts/run-vscode-smoke.ts ./scripts/check-ares-fork-drift.ts ./scripts/stage-ares-runtime-notices.ts ./scripts/package-ares-macos-runtime.ts ./scripts/check-framework-65816-oracle.ts ./scripts/check-framework-spc700-oracle.ts ./scripts/check-framework-superfx-oracle.ts ./docs/v1.0.0-release-plan.md ./package.json ./tsconfig.base.json ./packages/core/package.json ./packages/cli/tsconfig.json ./ava.external.config.js ./docs/README.md \"./packages/*/*.md\" packages/core/README.md packages/language-server/README.md packages/plugin-65xx/README.md packages/plugin-author/README.md packages/plugin-loader-node/README.md packages/plugin-snes/README.md packages/vscode-extension/README.md ./scripts/bundle-notices.mjs",
    "prefmt": "oxfmt ./README.md ./CONTRIBUTING.md ./SECURITY.md ./packages/disassembler/ARCHITECTURE.md ./TESTING.md ./packages/debug-adapter/src ./packages/debug-adapter/tests ./packages/debug-adapter/package.json ./packages/debug-adapter/tsconfig.json ./packages/debug-adapter/README.md ./packages/debug-sidecar-ares/src ./packages/debug-sidecar-ares/tests ./packages/debug-sidecar-ares/esbuild.mjs ./packages/debug-sidecar-ares/package.json ./packages/debug-sidecar-ares/tsconfig.json ./packages/debug-sidecar-ares/README.md ./packages/vscode-extension/tests-host ./scripts/check-documentation.ts ./scripts/clean-workspace-build.ts ./scripts/run-vscode-smoke.ts ./scripts/check-ares-fork-drift.ts ./scripts/stage-ares-runtime-notices.ts ./scripts/package-ares-macos-runtime.ts ./scripts/check-framework-65816-oracle.ts ./scripts/check-framework-spc700-oracle.ts ./scripts/check-framework-superfx-oracle.ts ./docs/v1.0.0-release-plan.md ./package.json ./tsconfig.base.json ./packages/core/package.json ./packages/cli/tsconfig.json ./ava.external.config.js ./docs/README.md \"./packages/*/*.md\" packages/core/README.md packages/language-server/README.md packages/plugin-65xx/README.md packages/plugin-author/README.md packages/plugin-loader-node/README.md packages/plugin-snes/README.md packages/vscode-extension/README.md ./scripts/bundle-notices.mjs",
    "scripts:typecheck": "tsc -p scripts/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p packages/vscode-extension/media/tsconfig.json --noEmit",
    "sidecar:build": "node packages/debug-sidecar-ares/esbuild.mjs",
    "sidecar:smoke": "node packages/debug-sidecar-ares/out/sidecar.mjs --help",
    "test:coverage": "cross-env NODE_ENV=test c8 ava",
    "test:som-assets": "node --conditions=uttori-source --import=tsx --test secret-of-mana/tools/som-asset-plugin.test.mjs secret-of-mana/tools/asset-authoring.test.mjs secret-of-mana/tools/frame-authoring.test.mjs secret-of-mana/tools/research-authoring.test.mjs secret-of-mana/tools/capture-source-index.test.mjs",
    "test:external": "cross-env NODE_ENV=test ava --config ava.external.config.js",
    "test:serial": "cross-env NODE_ENV=test c8 ava --serial --concurrency=1",
    "test:watch": "cross-env NODE_ENV=test ava --watch",
    "test": "cross-env NODE_ENV=test ava",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run scripts:typecheck && npm run example:typecheck",
    "validate": "npm ls",
    "verify": "npm run make-types && npm run fmt:check && npm run lint && npm run check:boundaries && npm run docs:check && npm run typecheck && npm run cli:build && npm run cli:smoke && npm run sidecar:build && npm run sidecar:smoke && npm run test:serial && npm run test:som-assets && npm run coverage:check && npm run lsp:typecheck && npm run vscode:typecheck",
    "vscode:build": "node packages/vscode-extension/esbuild.mjs",
    "vscode:package": "npm run package --workspace uttori-asm-vscode",
    "vscode:smoke": "npm run vscode:build && node --conditions=uttori-source --import=tsx scripts/run-vscode-smoke.ts",
    "vscode:typecheck": "tsc -p packages/vscode-extension/tsconfig.json --noEmit",
    "vscode:smoke:installed": "cross-env UTTORI_VSCODE_TEST_VSIX=packages/vscode-extension/uttori-asm-vscode-1.0.0.vsix node --conditions=uttori-source --import=tsx scripts/run-vscode-smoke.ts",
    "api:inventory": "node --conditions=uttori-source --import=tsx scripts/inventory-package-api.ts",
    "api:check": "node --conditions=uttori-source --import=tsx scripts/inventory-package-api.ts --check",
    "benchmark:package-contracts": "node --conditions=uttori-source --import=tsx scripts/benchmark-package-contracts.ts",
    "check:runtimes": "node scripts/check-runtime-bundles.mjs",
    "benchmark:source-export": "node --conditions=uttori-source --import=tsx scripts/benchmark-source-export.ts"
