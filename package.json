{
  "name": "uttori-asm",
  "version": "1.0.0",
  "private": true,
  "description": "A pluggable assembler toolkit for TypeScript and Node.js.",
  "keywords": [],
  "homepage": "https://github.com/uttori/asm",
  "license": "MIT",
  "author": "Matthew Callis <matthew.callis@gmail.com>",
  "contributors": [],
  "repository": "uttori/asm",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "npm run check:boundaries && npm run make-types && npm run lsp:build && npm run vscode:build",
    "make-types": "rm -rf dist packages/core/dist packages/plugin-loader-node/dist packages/plugin-snes/dist packages/plugin-65xx/dist && tsc --project ./tsconfig.json && npm run make-types --workspaces --if-present && npm run example:typecheck",
    "typecheck": "tsc --project ./tsconfig.json --noEmit && npm run typecheck --workspaces --if-present && npm run scripts:typecheck && npm run example:typecheck",
    "scripts:typecheck": "tsc -p scripts/tsconfig.json --noEmit",
    "example:typecheck": "tsc -p packages/plugin-author/tsconfig.json --noEmit",
    "check:boundaries": "node --import=tsx scripts/check-package-boundaries.ts",
    "cli": "tsx src/cli.ts",
    "fixture:diff": "tsx scripts/diff.ts",
    "fixture:asar": "tsx scripts/run-asar-fixtures.ts",
    "fixture:chou": "tsx scripts/run-chou.ts",
    "fixture:yoshi:diff": "tsx scripts/diff.ts --fixture yoshi",
    "fixture:slideshow": "tsx scripts/run-slideshow.ts",
    "fixture:slideshow:legacy": "tsx scripts/run-slideshow-legacy.ts",
    "fixture:smrpg:extract": "tsx scripts/extract-smrpg-assets.ts",
    "fixture:tmnt:extract": "tsx scripts/extract-tmnt-assets.ts",
    "fixture:tmnt:framework": "tsx scripts/place-snes-rom-framework.ts",
    "fixtures:status": "tsx scripts/fixtures-status.ts",
    "fmt": "oxfmt ./src ./packages/core/src ./packages/plugin-loader-node/src ./packages/plugin-loader-node/tests ./packages/plugin-loader-node/package.json ./packages/plugin-loader-node/tsconfig.json ./packages/plugin-loader-node/asm-config.schema.json ./packages/plugin-snes/src ./packages/plugin-snes/package.json ./packages/plugin-snes/tsconfig.json ./packages/plugin-65xx/src ./packages/plugin-65xx/package.json ./packages/plugin-65xx/tsconfig.json ./scripts/run-asar-fixtures.ts ./scripts/run-slideshow.ts ./scripts/run-slideshow-legacy.ts ./scripts/run-chou.ts ./scripts/external-fixtures.ts ./scripts/fixtures-status.ts ./scripts/ci-external.ts ./scripts/extract-smrpg-assets.ts ./scripts/extract-tmnt-assets.ts ./scripts/place-snes-rom-framework.ts ./scripts/diff.ts ./fixtures/fixture-manifest.ts ./tests/external-fixture-manifest.test.ts ./scripts/smoke-language-server-bundle.ts ./scripts/check-package-boundaries.ts ./scripts/check-package-tarballs.ts ./packages/plugin-author ./tests/package-boundaries.test.ts ./packages/language-server/src ./packages/language-server/esbuild.mjs ./packages/language-server/package.json ./packages/language-server/tsconfig.json ./packages/vscode-extension/src ./packages/vscode-extension/esbuild.mjs ./packages/vscode-extension/package.json ./packages/vscode-extension/tsconfig.json ./packages/vscode-extension/language-configuration.json ./packages/vscode-extension/syntaxes ./packages/vscode-extension/snippets/uttori-asm.json",
    "fmt:check": "oxfmt --check ./src ./packages/core/src ./packages/plugin-loader-node/src ./packages/plugin-loader-node/tests ./packages/plugin-loader-node/package.json ./packages/plugin-loader-node/tsconfig.json ./packages/plugin-loader-node/asm-config.schema.json ./packages/plugin-snes/src ./packages/plugin-snes/package.json ./packages/plugin-snes/tsconfig.json ./packages/plugin-65xx/src ./packages/plugin-65xx/package.json ./packages/plugin-65xx/tsconfig.json ./scripts/run-asar-fixtures.ts ./scripts/run-slideshow.ts ./scripts/run-slideshow-legacy.ts ./scripts/run-chou.ts ./scripts/external-fixtures.ts ./scripts/fixtures-status.ts ./scripts/ci-external.ts ./scripts/extract-smrpg-assets.ts ./scripts/extract-tmnt-assets.ts ./scripts/place-snes-rom-framework.ts ./scripts/diff.ts ./fixtures/fixture-manifest.ts ./tests/external-fixture-manifest.test.ts ./scripts/smoke-language-server-bundle.ts ./scripts/check-package-boundaries.ts ./scripts/check-package-tarballs.ts ./packages/plugin-author ./tests/package-boundaries.test.ts ./packages/language-server/src ./packages/language-server/esbuild.mjs ./packages/language-server/package.json ./packages/language-server/tsconfig.json ./packages/vscode-extension/src ./packages/vscode-extension/esbuild.mjs ./packages/vscode-extension/package.json ./packages/vscode-extension/tsconfig.json ./packages/vscode-extension/language-configuration.json ./packages/vscode-extension/syntaxes ./packages/vscode-extension/snippets/uttori-asm.json",
    "lint": "oxlint ./src ./packages/core/src ./packages/plugin-loader-node/src ./packages/plugin-snes/src ./packages/plugin-65xx/src ./scripts/check-package-boundaries.ts ./scripts/check-package-tarballs.ts ./scripts/external-fixtures.ts ./scripts/fixtures-status.ts ./scripts/ci-external.ts ./scripts/place-snes-rom-framework.ts ./fixtures/fixture-manifest.ts ./packages/plugin-author/src ./packages/language-server/src ./packages/vscode-extension/src",
    "lint:fix": "oxlint ./src ./packages/core/src ./packages/plugin-loader-node/src ./packages/plugin-snes/src ./packages/plugin-65xx/src ./scripts/check-package-boundaries.ts ./scripts/check-package-tarballs.ts ./scripts/external-fixtures.ts ./scripts/fixtures-status.ts ./scripts/ci-external.ts ./scripts/place-snes-rom-framework.ts ./fixtures/fixture-manifest.ts ./packages/plugin-author/src ./packages/language-server/src ./packages/vscode-extension/src --fix",
    "benchmark": "tsx scripts/run-production-benchmarks.ts",
    "benchmark:smoke": "tsx scripts/run-production-benchmarks.ts --fast",
    "benchmark:chou": "tsx scripts/run-production-benchmarks.ts --fast --fixture chou --isolate --no-instrumentation --max-median-ms 30000",
    "benchmark:chou:stable": "tsx scripts/run-production-benchmarks.ts --warmups 0 --repetitions 3 --fixture chou --isolate --no-instrumentation --max-median-ms 30000",
    "benchmark:smrpg": "tsx scripts/run-production-benchmarks.ts --fast --fixture smrpg --isolate --max-median-ms 60000",
    "benchmark:smrpg:stable": "tsx scripts/run-production-benchmarks.ts --warmups 0 --repetitions 3 --fixture smrpg --isolate --no-instrumentation --max-median-ms 60000",
    "benchmark:lsp-indexing": "tsx scripts/benchmark-lsp-indexing.ts",
    "benchmark:lsp-indexing:fast": "tsx scripts/benchmark-lsp-indexing.ts --fast",
    "benchmark:lsp-indexing:chou": "tsx scripts/benchmark-lsp-indexing.ts --warmups 0 --reps 3",
    "test": "NODE_ENV=test ava",
    "test:external": "NODE_ENV=test ava --config ava.external.config.js",
    "ci:external": "tsx scripts/ci-external.ts",
    "test:coverage": "NODE_ENV=test c8 ava",
    "test:serial": "NODE_ENV=test c8 ava --serial --concurrency=1",
    "test:debug": "NODE_ENV=test DEBUG=Uttori* c8 ava --serial --concurrency=1",
    "test:watch": "NODE_ENV=test DEBUG=Assembler,MathCore ava --watch",
    "coverage:check": "c8 report --check-coverage --statements 92 --branches 88 --functions 93",
    "coverage:stable": "c8 report --check-coverage --per-file --statements 95 --branches 90 --functions 95 --include=packages/core/src/directives/namespace.ts --include=packages/core/src/services/macro-engine.ts --include=packages/core/src/lsp/position-lookup.ts --include=packages/core/src/lsp/workspace-index.ts",
    "coverage:verify": "npm run test:serial && npm run coverage:check && npm run coverage:stable",
    "validate": "npm ls",
    "verify": "npm run fmt:check && npm run lint && npm run check:boundaries && npm run typecheck && npm run make-types && npm run coverage:verify && npm run lsp:typecheck && npm run vscode:typecheck",
    "pack:check": "node --import=tsx scripts/check-package-tarballs.ts",
    "lsp:typecheck": "tsc -p packages/language-server/tsconfig.json --noEmit",
    "lsp:build": "node packages/language-server/esbuild.mjs",
    "lsp:smoke": "node --import=tsx scripts/smoke-language-server-bundle.ts",
    "vscode:typecheck": "tsc -p packages/vscode-extension/tsconfig.json --noEmit",
    "vscode:build": "node packages/vscode-extension/esbuild.mjs",
    "vscode:package": "npm run lsp:build && npm run vscode:build && npm run package --workspace uttori-asm-vscode"
  },
  "dependencies": {
    "@uttori/asm-core": "1.0.0",
    "@uttori/asm-plugin-loader-node": "1.0.0",
    "@uttori/asm-plugin-snes": "1.0.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.4.0",
    "@types/semver": "^7.8.0",
    "@types/sinon": "^22.0.0",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "eslint-plugin-anti-trojan-source": "^1.1.7",
    "eslint-plugin-optimize-regex": "^1.2.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-xss": "^0.1.12",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sinon": "^22.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "debug": "^4.4.3"
  },
  "overrides": {
    "typescript": "^7.0.2",
    "yargs": "^18.0.0"
  },
  "ava": {
    "concurrency": 10,
    "extensions": [
      "ts"
    ],
    "failFast": false,
    "files": [
      "tests/**/*.test.*",
      "packages/*/tests/**/*.test.*",
      "!**/*.external.test.ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ],
    "serial": false,
    "tap": false,
    "timeout": "120000",
    "verbose": true
  },
  "c8": {
    "all": true,
    "check-coverage": false,
    "clean": true,
    "exclude": [
      "src/cli.ts",
      "src/debug-tracing.ts"
    ],
    "include": [
      "packages/core/src/**/*.ts",
      "packages/plugin-loader-node/src/**/*.ts",
      "packages/{core,plugin-*}/src/**/*.ts"
    ],
    "per-file": false
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "keytar@7.9.0": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
