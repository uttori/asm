{
  "name": "snes-asm-js",
  "version": "1.0.0",
  "description": "",
  "author": "Matthew Callis <matthew.callis@gmail.com>",
  "contributors": [],
  "license": "MIT",
  "repository": "MatthewCallis/snes-asm-js",
  "homepage": "https://github.com/MatthewCallis/snes-asm-js",
  "keywords": [],
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^24.9.1",
    "@types/sinon": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "ava": "^7.0.0",
    "c8": "^11.0.0",
    "eslint": "^9.38.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-anti-trojan-source": "^1.1.2",
    "eslint-plugin-ava": "^15",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-no-inferred-method-name": "^2.0.0",
    "eslint-plugin-optimize-regex": "^1.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-xss": "^0.1.12",
    "jsdoc-to-markdown": "^9.1.3",
    "sinon": "^21.0.3",
    "tsimp": "^2.0.12",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/*",
    "src/*"
  ],
  "module": "src/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "ava": {
    "files": [
      "tests/**/*.test.*"
    ],
    "concurrency": 10,
    "extensions": {
      "ts": "module"
    },
    "nodeArguments": [
      "--import=tsimp"
    ],
    "failFast": false,
    "serial": true,
    "tap": false,
    "timeout": "45000",
    "verbose": true
  },
  "c8": {
    "clean": true,
    "per-file": true,
    "check-coverage": false,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": []
  },
  "scripts": {
    "docs": "jsdoc2md --private --example-lang js --template README.hbs src/index.js > README.md; cp README.md docs/README.md",
    "lint": "eslint --config eslint.config.js ./src",
    "make-types": "tsc --module nodenext --project ./tsconfig.json",
    "test": "NODE_ENV=test c8 ava",
    "test:ava": "NODE_ENV=test c8 ava --serial --concurrency=1",
    "test:debug": "NODE_ENV=test DEBUG=Uttori* c8 ava --serial --concurrency=1",
    "test:watch": "NODE_ENV=test DEBUG=Assembler,MathCore ava --watch",
    "validate": "npm ls"
  }
}
