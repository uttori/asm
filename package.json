  "dependencies": {
    "@uttori/asm-core": "1.0.0",
    "@uttori/asm-plugin-loader-node": "1.0.0",
    "@uttori/asm-plugin-snes": "1.0.0",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@types/sinon": "^22.0.2",
    "@vscode/test-electron": "^3.1.0",
    "ava": "^8.3.0",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "eslint-plugin-anti-trojan-source": "^1.1.7",
    "eslint-plugin-ava": "^18.0.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-optimize-regex": "^1.2.1",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-xss": "^0.1.12",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sinon": "^22.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "typescript": "^7.0.2",
    "yargs": "^18.0.0"
  },
  "ava": {
    "concurrency": 10,
    "extensions": [
      "ts"
    ],
    "failFast": false,
    "files": [
      "tests/**/*.test.*",
      "packages/*/tests/**/*.test.*",
      "!**/*.external.test.ts"
    ],
    "nodeArguments": [
      "--conditions=uttori-source",
      "--import=tsx"
    ],
    "serial": false,
    "tap": false,
    "timeout": "120000",
    "verbose": true
  },
  "c8": {
    "all": true,
    "check-coverage": false,
    "clean": true,
    "exclude": [
      "packages/plugin-author/**",
      "packages/core/src/directives/types.ts",
      "packages/core/src/debug-tracing.ts"
    ],
    "include": [
      "packages/*/src/**/*.ts"
    ],
    "per-file": false
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "keytar@7.9.0": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
