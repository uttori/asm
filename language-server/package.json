{
  "name": "@uttori/asm-language-server",
  "version": "1.0.0",
  "private": true,
  "description": "Language Server Protocol implementation for uttori-asm.",
  "license": "MIT",
  "author": "Matthew Callis <matthew.callis@gmail.com>",
  "bin": {
    "uttori-asm-language-server": "out/server.mjs"
  },
  "type": "module",
  "main": "out/server.mjs",
  "scripts": {
    "build": "node esbuild.mjs",
    "fmt": "oxfmt --config ../.oxfmtrc.json src esbuild.mjs package.json tsconfig.json",
    "fmt:check": "oxfmt --config ../.oxfmtrc.json --check src esbuild.mjs package.json tsconfig.json",
    "lint": "oxlint --config ../.oxlintrc.json src",
    "lint:fix": "oxlint --config ../.oxlintrc.json src --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.13"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
