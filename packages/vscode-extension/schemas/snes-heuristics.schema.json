{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SNES function-role heuristics",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "minimumConfidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "maxWindowInstructions": {
      "type": "integer",
      "minimum": 2,
      "maximum": 256,
      "default": 48
    },
    "disabledRules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Built-in or custom rule IDs to disable."
    },
    "registerRules": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "addresses",
          "access",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "addresses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777215
            },
            "description": "CPU bus hardware-register addresses; RAM lookalikes are rejected."
          },
          "access": {
            "enum": [
              "read",
              "write"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    }
  }
}
