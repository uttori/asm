{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["uttori-source"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "moduleDetection": "force",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["*.js", "webview-api.d.ts"]
}
