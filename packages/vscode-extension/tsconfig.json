{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vscode"],
    "outDir": "out",
    "customConditions": ["uttori-source"]
  },
  "include": ["src/**/*.ts", "tests-host/**/*.ts"]
}
