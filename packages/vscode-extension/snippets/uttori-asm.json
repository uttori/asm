{
  "Named struct record": {
    "prefix": "dataStruct",
    "body": ["dataStruct ${1:Record}[${2:0}], {", "\t${3:field} = ${4:\\$00}", "}", "$0"],
    "description": "Emit a complete named record at its declared address"
  },
  "Named struct table": {
    "prefix": "dataStructs",
    "body": [
      "dataStructs ${1:Record}",
      "\t[${2:0}] = { ${3:field} = ${4:\\$00} }",
      "endDataStructs",
      "$0"
    ],
    "description": "Emit consecutive indexed named records"
  },
  "Include asset": {
    "prefix": "includeAsset",
    "body": [
      "includeAsset(\"${1:art/title.png}\", \"${2:snes.tile.4bpp}\", ${3:palette: \"auto\"})"
    ],
    "description": "Convert and emit one named asset output"
  },
  "Subroutine": {
    "prefix": "sub",
    "body": ["${1:name}:", "\t$0", "\trts"],
    "description": "Labeled subroutine ending in RTS"
  }
}
