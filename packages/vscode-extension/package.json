{
  "name": "uttori-asm-vscode",
  "displayName": "Uttori Assembly",
  "version": "1.0.0",
  "private": true,
  "description": "Assembly editing, builds, ROM analysis, and debugging for SNES and 65xx.",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "6502",
    "65xx",
    "assembly",
    "debugger",
    "disassembler",
    "snes"
  ],
  "homepage": "https://github.com/uttori/asm/tree/master/packages/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/uttori/asm/issues"
  },
  "license": "MIT",
  "author": "Matthew Callis <matthew.callis@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/uttori/asm.git",
    "directory": "packages/vscode-extension"
  },
  "publisher": "matthewcallis",
  "main": "out/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "fmt": "oxfmt --config ../../.oxfmtrc.json src media tests-host esbuild.mjs package.json tsconfig.json language-configuration.json syntaxes snippets/uttori-asm.json",
    "fmt:check": "oxfmt --config ../../.oxfmtrc.json --check src media tests-host esbuild.mjs package.json tsconfig.json language-configuration.json syntaxes snippets/uttori-asm.json",
    "lint": "oxlint --config ../../.oxlintrc.json src tests-host",
    "lint:fix": "oxlint --config ../../.oxlintrc.json src tests-host --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@uttori/asm-assets": "1.0.0",
    "@uttori/asm-cli": "1.0.0",
    "@uttori/asm-core": "1.0.0",
    "@uttori/asm-debug-adapter": "1.0.0",
    "@uttori/asm-debug-sidecar-ares": "1.0.0",
    "@uttori/asm-disassembler": "1.0.0",
    "@uttori/asm-plugin-snes": "1.0.0",
    "jsonc-parser": "^3.3.1",
    "vscode-languageclient": "^10.1.1",
    "vscode-languageserver-types": "^3.18.3"
  },
  "devDependencies": {
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "asm.source.initDiz",
        "title": "Create Git Source Project from Diz Research",
        "category": "Assembly Source",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.build",
        "title": "Build Binary",
        "category": "Assembly"
      },
      {
        "command": "asm.assetPreview.open",
        "title": "Open Asset Preview",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.analysis.toggleAnnotations",
        "title": "Toggle Inline Source Information",
        "category": "Assembly",
        "icon": "$(eye)",
        "toggled": "asm.editorInfo.inlineEnabled"
      },
      {
        "command": "asm.toggleWatch",
        "title": "Toggle Build on Save (Watch)",
        "category": "Assembly"
      },
      {
        "command": "asm.runEmulator",
        "title": "Run in Emulator",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.debugEmulator",
        "title": "Debug in Emulator",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.runAndWatch",
        "title": "Run and Watch",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.configureEmulatorRuntime",
        "title": "Configure Emulator Runtime",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.initConfig",
        "title": "Initialize uttori-asm.config.json",
        "category": "Assembly"
      },
      {
        "command": "asm.openPanel",
        "title": "Open Project Panel",
        "category": "Assembly"
      },
      {
        "command": "asm.outline.refresh",
        "title": "Refresh Project Outline",
        "icon": "$(refresh)",
        "category": "Assembly"
      },
      {
        "command": "asm.coverage.refresh",
        "title": "Refresh Analysis Coverage",
        "icon": "$(refresh)",
        "category": "Assembly"
      },
      {
        "command": "asm.sources.refresh",
        "title": "Refresh Sources",
        "icon": "$(refresh)",
        "category": "Assembly"
      },
      {
        "command": "asm.analysis.navigate",
        "title": "Open Analysis Source or Disassembly",
        "icon": "$(go-to-file)",
        "category": "Assembly"
      },
      {
        "command": "asm.coverage.classifyRange",
        "title": "Classify Analysis Range",
        "icon": "$(edit)",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.coverage.setStateEntryPoint",
        "title": "Set Analysis State / Entry Point",
        "icon": "$(symbol-variable)",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.coverage.resolveTarget",
        "title": "Resolve Indirect Target",
        "icon": "$(references)",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.coverage.renameLabel",
        "title": "Rename Analysis Label",
        "icon": "$(symbol-key)",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.coverage.explainEvidence",
        "title": "Explain Analysis Evidence",
        "icon": "$(inspect)",
        "category": "Assembly"
      },
      {
        "command": "asm.trace.start",
        "title": "Start Runtime Trace Recording",
        "category": "Assembly"
      },
      {
        "command": "asm.trace.stop",
        "title": "Stop Runtime Trace Recording",
        "category": "Assembly"
      },
      {
        "command": "asm.trace.stopAnalyze",
        "title": "Stop Capture and Import Evidence",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.analysis.showOutput",
        "title": "Show Analysis Output",
        "category": "Assembly"
      },
      {
        "command": "asm.trace.cancelLiveAnalysis",
        "title": "Stop Live Bus Analysis",
        "category": "Assembly"
      },
      {
        "command": "asm.trace.mark",
        "title": "Add Capture Milestone",
        "category": "Assembly"
      },
      {
        "command": "asm.trace.replay",
        "title": "Replay Capture Inputs",
        "category": "Assembly"
      },
      {
        "command": "asm.trace.restore",
        "title": "Restore Capture Pre-action State",
        "category": "Assembly"
      },
      {
        "command": "asm.editorInfo.choosePreset",
        "title": "Choose Editor Information Preset",
        "category": "Assembly"
      },
      {
        "command": "asm.editorInfo.configureInline",
        "title": "Configure Inline Fields",
        "category": "Assembly"
      },
      {
        "command": "asm.editorInfo.showStatus",
        "title": "Show Inline Source Information Status",
        "category": "Assembly"
      },
      {
        "command": "asm.editorInfo.inspectLine",
        "title": "Inspect Line Information",
        "category": "Assembly"
      },
      {
        "command": "asm.source.init",
        "title": "Create Git Source Project",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.clean",
        "title": "Clean Abandoned Source Temporary Data",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.discard",
        "title": "Discard Generated Candidate",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.select",
        "title": "Select Source Project",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.refresh",
        "title": "Refresh Source Status",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.prepare",
        "title": "Prepare Regeneration",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.preview",
        "title": "Preview Regeneration with Current Edits",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.apply",
        "title": "Apply Regeneration after Checkpoint",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.finish",
        "title": "Validate and Finish Regeneration",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.abort",
        "title": "Abort Regeneration",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.relocate",
        "title": "Relocate Source Object",
        "category": "ASM",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.expand",
        "title": "Expand ROM Capacity",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.build",
        "title": "Build and Check Source",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.importCapture",
        "title": "Import Capture into Source Project",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.analyze",
        "title": "Analyze Source Project Evidence",
        "category": "Assembly",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.editResearch",
        "title": "Edit Symbol Research",
        "category": "Assembly Source",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asm.source.editAnalysis",
        "title": "Edit Analysis Research",
        "category": "Assembly Source",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "asm.source.initDiz"
        },
        {
          "command": "asm.build"
        },
        {
          "command": "asm.toggleWatch"
        },
        {
          "command": "asm.runEmulator"
        },
        {
          "command": "asm.debugEmulator"
        },
        {
          "command": "asm.runAndWatch"
        },
        {
          "command": "asm.configureEmulatorRuntime"
        },
        {
          "command": "asm.initConfig"
        },
        {
          "command": "asm.openPanel"
        },
        {
          "command": "asm.outline.refresh"
        },
        {
          "command": "asm.coverage.refresh"
        },
        {
          "command": "asm.analysis.navigate",
          "when": "false"
        },
        {
          "command": "asm.coverage.classifyRange"
        },
        {
          "command": "asm.coverage.setStateEntryPoint"
        },
        {
          "command": "asm.coverage.resolveTarget"
        },
        {
          "command": "asm.coverage.renameLabel"
        },
        {
          "command": "asm.coverage.explainEvidence"
        },
        {
          "command": "asm.trace.start"
        },
        {
          "command": "asm.trace.stop"
        },
        {
          "command": "asm.trace.stopAnalyze"
        }
      ],
      "view/title": [
        {
          "command": "asm.outline.refresh",
          "when": "view == uttori-asm.projectOutline",
          "group": "navigation"
        },
        {
          "command": "asm.coverage.refresh",
          "when": "view == uttori-asm.analysisCoverage",
          "group": "navigation"
        },
        {
          "command": "asm.sources.refresh",
          "when": "view == uttori-asm.sources",
          "group": "navigation"
        },
        {
          "command": "asm.source.refresh",
          "when": "view == uttori-asm.sourceProject",
          "group": "navigation"
        },
        {
          "command": "asm.source.select",
          "when": "view == uttori-asm.sourceProject",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "asm.coverage.classifyRange",
          "when": "view == uttori-asm.analysisCoverage && viewItem == analysisCoverageSegment && isWorkspaceTrusted",
          "group": "inline"
        },
        {
          "command": "asm.coverage.explainEvidence",
          "when": "view == uttori-asm.analysisCoverage && viewItem == analysisCoverageSegment",
          "group": "inline@2"
        },
        {
          "command": "asm.coverage.setStateEntryPoint",
          "when": "view == uttori-asm.analysisCoverage && viewItem == analysisCoverageSegment && isWorkspaceTrusted",
          "group": "analysis@1"
        },
        {
          "command": "asm.coverage.resolveTarget",
          "when": "view == uttori-asm.analysisCoverage && viewItem == analysisCoverageSegment && isWorkspaceTrusted",
          "group": "analysis@2"
        },
        {
          "command": "asm.coverage.renameLabel",
          "when": "view == uttori-asm.analysisCoverage && viewItem == analysisCoverageSegment && isWorkspaceTrusted",
          "group": "analysis@3"
        }
      ],
      "editor/title": [
        {
          "command": "asm.analysis.toggleAnnotations",
          "when": "editorLangId == uttori-snes || editorLangId == uttori-65xx || resourceExtname == .asm || resourceExtname == .src || resourceExtname == .SRC || resourceExtname == .s || resourceExtname == .inc",
          "group": "navigation@1"
        }
      ],
      "editor/title/run": [
        {
          "command": "asm.build",
          "when": "editorLangId == uttori-snes || editorLangId == uttori-65xx || resourceExtname == .asm || resourceExtname == .src || resourceExtname == .SRC || resourceExtname == .s || resourceExtname == .inc",
          "group": "navigation"
        },
        {
          "command": "asm.runEmulator",
          "when": "isWorkspaceTrusted && (editorLangId == uttori-snes || editorLangId == uttori-65xx || resourceExtname == .asm || resourceExtname == .src || resourceExtname == .SRC || resourceExtname == .s || resourceExtname == .inc)",
          "group": "navigation@2"
        },
        {
          "command": "asm.debugEmulator",
          "when": "isWorkspaceTrusted && (editorLangId == uttori-snes || editorLangId == uttori-65xx || resourceExtname == .asm || resourceExtname == .src || resourceExtname == .SRC || resourceExtname == .s || resourceExtname == .inc)",
          "group": "navigation@3"
        }
      ]
    },
    "languages": [
      {
        "id": "uttori-snes",
        "aliases": [
          "Uttori SNES",
          "SNES Assembly"
        ],
        "extensions": [
          ".asm",
          ".src",
          ".SRC",
          ".s",
          ".inc"
        ],
        "firstLine": "(?i)^\\s*(lorom|hirom|exlorom|exhirom|sa1rom|sfxrom|norom|fullsa1rom)\\b",
        "configuration": "./language-configuration.json"
      },
      {
        "id": "uttori-65xx",
        "aliases": [
          "Uttori 65xx",
          "65xx Assembly"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "breakpoints": [
      {
        "language": "uttori-snes"
      },
      {
        "language": "uttori-65xx"
      }
    ],
    "debuggers": [
      {
        "type": "uttori-asm",
        "label": "Uttori ASM Debugger",
        "languages": [
          "uttori-snes",
          "uttori-65xx"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "Exact binary fingerprinted by the debug map."
              },
              "debugMap": {
                "type": "string",
                "description": "Versioned Uttori ASM debug-map JSON file."
              },
              "sourceRoot": {
                "type": "string",
                "description": "Base directory for relative source paths in the debug map."
              },
              "replay": {
                "type": "string",
                "description": "Optional replay snapshot JSON. When omitted, a deterministic timeline is synthesized from the debug map."
              },
              "backend": {
                "type": "string",
                "enum": [
                  "replay",
                  "ares"
                ],
                "default": "replay",
                "description": "Debug backend. Live backends require a trusted workspace and separately managed emulator runtime."
              },
              "runtimeManifest": {
                "type": "string",
                "description": "Versioned emulator runtime manifest required by live backends."
              },
              "emulator": {
                "type": "string",
                "description": "Separately installed emulator executable required by live backends."
              },
              "runtimeDirectory": {
                "type": "string",
                "description": "Portable emulator runtime root required by live backends."
              },
              "sidecar": {
                "type": "string",
                "description": "Optional development override for the bundled MIT sidecar module."
              },
              "aresSystem": {
                "type": "string",
                "description": "Optional ares system name. Defaults to Super Famicom."
              },
              "fastBoot": {
                "type": "boolean",
                "default": true,
                "description": "Use ares fast boot."
              },
              "sourceProject": {
                "type": "boolean",
                "default": false,
                "description": "Build this workspace Git source project before F5; use the verified ROM and debug map from that build."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "uttori-asm",
            "request": "launch",
            "name": "Debug Uttori ASM (Replay)",
            "backend": "replay",
            "program": "${workspaceFolder}/build/rebuilt-content.sfc",
            "debugMap": "${workspaceFolder}/build/rebuilt-content.sfc.debug.json",
            "sourceRoot": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Uttori ASM: Replay Debug",
            "description": "Debug a fingerprinted binary with the deterministic in-memory backend.",
            "body": {
              "type": "uttori-asm",
              "request": "launch",
              "name": "Debug Uttori ASM (Replay)",
              "backend": "replay",
              "program": "^\"${workspaceFolder}/build/rebuilt-content.sfc\"",
              "debugMap": "^\"${workspaceFolder}/build/rebuilt-content.sfc.debug.json\"",
              "sourceRoot": "^\"${workspaceFolder}\""
            }
          },
          {
            "label": "Uttori ASM: Live ares Debug",
            "description": "Debug a fingerprinted SNES ROM with a manifest-verified ares runtime.",
            "body": {
              "type": "uttori-asm",
              "request": "launch",
              "name": "Debug Uttori ASM (ares)",
              "backend": "ares",
              "program": "^\"${workspaceFolder}/build/rebuilt-content.sfc\"",
              "debugMap": "^\"${workspaceFolder}/build/rebuilt-content.sfc.debug.json\"",
              "sourceRoot": "^\"${workspaceFolder}\"",
              "runtimeManifest": "^\"${workspaceFolder}/.debug/ares-runtime-manifest.json\"",
              "emulator": "^\"${workspaceFolder}/.debug/ares/bin/ares-headless\"",
              "runtimeDirectory": "^\"${workspaceFolder}/.debug/ares\""
            }
          }
        ]
      }
    ],
    "grammars": [
      {
        "scopeName": "source.uttori-asm.base",
        "path": "./syntaxes/uttori-asm-base.tmLanguage.json"
      },
      {
        "language": "uttori-65xx",
        "scopeName": "source.uttori-65xx",
        "path": "./syntaxes/uttori-65xx.tmLanguage.json"
      },
      {
        "language": "uttori-snes",
        "scopeName": "source.uttori-snes",
        "path": "./syntaxes/uttori-snes.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "uttori-snes",
        "scopes": {
          "struct": [
            "entity.name.type.struct.uttori-asm"
          ],
          "property": [
            "variable.other.member.uttori-asm"
          ],
          "label": [
            "entity.name.function.label.uttori-asm"
          ],
          "namespace": [
            "entity.name.namespace.uttori-asm"
          ],
          "macro": [
            "entity.name.function.macro.uttori-asm"
          ]
        }
      },
      {
        "language": "uttori-65xx",
        "scopes": {
          "struct": [
            "entity.name.type.struct.uttori-asm"
          ],
          "property": [
            "variable.other.member.uttori-asm"
          ],
          "label": [
            "entity.name.function.label.uttori-asm"
          ],
          "namespace": [
            "entity.name.namespace.uttori-asm"
          ],
          "macro": [
            "entity.name.function.macro.uttori-asm"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "uttori-snes",
        "path": "./snippets/uttori-asm.json"
      },
      {
        "language": "uttori-65xx",
        "path": "./snippets/uttori-asm.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "uttori-asm",
          "title": "Uttori Assembly",
          "icon": "media/uttori-asm.svg"
        }
      ]
    },
    "views": {
      "uttori-asm": [
        {
          "id": "uttori-asm.sourceProject",
          "name": "Source Project",
          "type": "tree"
        },
        {
          "type": "webview",
          "id": "uttori-asm.projectPanel",
          "name": "Project"
        },
        {
          "type": "tree",
          "id": "uttori-asm.projectOutline",
          "name": "Outline"
        },
        {
          "type": "tree",
          "id": "uttori-asm.sources",
          "name": "Sources"
        },
        {
          "type": "tree",
          "id": "uttori-asm.analysisCoverage",
          "name": "Analysis Coverage"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "uttori-asm.projectOutline",
        "contents": "No analysed assembly files yet.\n[Open project settings](command:asm.openPanel)"
      },
      {
        "view": "uttori-asm.analysisCoverage",
        "contents": "No native analysis project found. Set `asm.analysisProject` or create an `analysis.json` project with the CLI."
      },
      {
        "view": "uttori-asm.sources",
        "contents": "No native analysis project found. Import evidence into an analysis project, then inspect its sources here."
      }
    ],
    "configuration": {
      "title": "Uttori Assembly",
      "properties": {
        "asm.configFile": {
          "type": "string",
          "default": "",
          "description": "Path to uttori-asm.config.json relative to the workspace root. When empty, uttori-asm.config.json is discovered automatically."
        },
        "asm.plugins": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "module"
                ],
                "properties": {
                  "module": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "default": [],
          "description": "Plugin module specifiers appended to plugins from uttori-asm.config.json. Workspace Trust is required."
        },
        "asm.target": {
          "type": "string",
          "default": "",
          "description": "Target contribution ID or alias. The language server validates it against active plugin metadata."
        },
        "asm.entryPoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Project entry-point files (relative to the workspace root) analysed as include roots. When empty, each open file is treated as its own root."
        },
        "asm.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional include search paths handed to the assembler. When empty, project configuration or target defaults apply."
        },
        "asm.architecture": {
          "type": "string",
          "default": "",
          "description": "Architecture contribution ID or alias. The language server validates it against the selected target."
        },
        "asm.buildOutput": {
          "type": "string",
          "default": "",
          "description": "Output path for the assembled binary. When empty, the selected target's default extension is used."
        },
        "asm.baseImage": {
          "type": "string",
          "default": "",
          "description": "Optional base image file to patch when building."
        },
        "asm.analysisProject": {
          "type": "string",
          "default": "",
          "description": "Native analysis-project directory or analysis.json path, absolute or relative to each workspace folder. When empty, up to 32 workspace analysis projects are discovered automatically."
        },
        "asm.analysis.showAnnotations": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Show aligned project-state and runtime analysis overlays in source editors. Toggle with the eye button beside Build Binary.",
          "deprecationMessage": "Use asm.editorInfo.inline.enabled. Explicit values remain supported when the replacement is unset."
        },
        "asm.analysis.annotationColumn": {
          "type": "integer",
          "scope": "resource",
          "minimum": 0,
          "default": 80,
          "description": "Preferred minimum source column for analysis overlays. All visible overlays align beyond the longest annotated line with a three-column gap. Tab width follows the editor setting.",
          "deprecationMessage": "Use asm.editorInfo.inline.column and asm.editorInfo.inline.placement. Explicit values remain supported."
        },
        "asm.analysis.maxWorkItems": {
          "type": "integer",
          "scope": "resource",
          "minimum": 1,
          "default": 100000,
          "description": "Maximum static-analysis work items when regenerating disassembly. This limits CPU-state and call-path exploration, not imported trace events. Increase for larger analyses. Higher values require more time and memory. Incomplete analysis cannot discard known code."
        },
        "asm.analysis.maxMemoryMiB": {
          "type": "integer",
          "scope": "resource",
          "minimum": 128,
          "default": 4096,
          "description": "JavaScript heap budget in MiB for the isolated analysis-view process and each disassembly maintenance process. Increase for large analysis projects. Maintenance phases exit before the next starts. Views reuse a validated project cache. Total process memory may exceed the heap budget."
        },
        "asm.trace.indexMode": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "full"
          ],
          "default": "full",
          "description": "Retains all supplied instruction bytes, register snapshots, exact execution counts and bus observations."
        },
        "asm.trace.maxImportSizeMiB": {
          "type": "integer",
          "scope": "resource",
          "minimum": 1,
          "default": 2048,
          "description": "Maximum native runtime trace file size in MiB (2048 = 2 GiB). Set in the project workspace settings for unusually large captures. Trace chunks are read incrementally. Memory use also depends on the number of distinct execution observations. This is separate from the static-analysis work budget."
        },
        "uttoriAsmLanguageServer.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Uttori Assembly language server."
        },
        "asm.debug.captureSink": {
          "type": "string",
          "enum": [
            "stream",
            "native-file"
          ],
          "default": "stream",
          "description": "Lossless ACT2 destination: stream through the editor, or let the local ares runtime write binary chunks directly. Native file capture requires the capture-file runtime and a paused debugger when starting."
        },
        "asm.debug.traceMode": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "live",
            "lossless-instructions",
            "lossless-bus",
            "lossless-bus-transfers",
            "lossless-bus-ppu"
          ],
          "default": "lossless-instructions",
          "enumDescriptions": [
            "Live instruction trace with bounded buffering. Dropped events are reported.",
            "Lossless fetched instruction bytes and CPU state, saved to ACT2 for disassembly import. Requires the capture-v2 ares runtime.",
            "Lossless CPU/DMA/HDMA bus accesses with timing, channel and transfer phase, saved to ACT2 for bus activity import. Requires the capture-bus ares runtime.",
            "Lossless bus accesses plus explicit DMA run and HDMA payload-burst boundaries and channel snapshots. Requires the capture-transfer runtime. Imports show completed, interrupted and partial transfer windows.",
            "Lossless bus and transfer capture with verified VRAM/CGRAM/OAM write destinations, blocked writes and latch-only outcomes, including during rendering. Requires the capture-ppu runtime."
          ],
          "description": "Runtime trace recording mode. Lossless modes slow emulation while storage drains and require a matching ares runtime. Instruction and bus capture are separate streams. Bus mode does not include fetched instruction bytes or full CPU registers."
        },
        "asm.debug.traceDetail": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "full",
            "pc"
          ],
          "default": "full",
          "description": "Full capture requires a runtime supplying execution-time instruction bytes, registers and bus accesses. Unsupported runtimes are rejected. Select pc explicitly to record addresses only. Both modes use bounded buffers and report dropped events."
        },
        "asm.analysis.cacheMaxMiB": {
          "type": "integer",
          "scope": "resource",
          "minimum": 0,
          "default": 256,
          "description": "Disposable SQL projection budget in MiB, applied after imports or explicit storage maintenance. Editor/export indexes remain available."
        },
        "asm.analysis.storageMaxMiB": {
          "type": "integer",
          "scope": "resource",
          "minimum": 0,
          "default": 0,
          "description": "Maximum live SQLite page allocation for new publications in MiB; 0 disables the ceiling. An exceeded budget rolls back the entire publication."
        },
        "asm.debug.liveBusAnalysis": {
          "type": "boolean",
          "default": false,
          "description": "Analyze native-file bus captures in an isolated process while recording. Shows provisional activity and publishes facts to the selected matching project after complete validation."
        },
        "asm.debug.liveBusMaxLagMiB": {
          "type": "integer",
          "default": 256,
          "minimum": 16,
          "maximum": 4096,
          "description": "Maximum unread durable capture backlog for live bus analysis, in MiB. Exceeding it stops analysis while native recording continues. Import the final archive offline."
        },
        "asm.debug.captureContext": {
          "type": "boolean",
          "default": true,
          "description": "Include paused start/end WRAM, a pre-action state, controller replay data, visual milestones, and a separate two-frame PPU/bus capture. Requires a matching local ares runtime. Disable only for bare trace capture."
        },
        "asm.editorInfo.preset": {
          "scope": "resource",
          "type": "string",
          "enum": [
            "compact",
            "authoring",
            "disassembly"
          ],
          "default": "compact",
          "description": "Default fields for editor information. Explicit inline parts and hover rows override the preset."
        },
        "asm.editorInfo.inline.enabled": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Show source information inline. Explicit legacy asm.analysis.showAnnotations is honored when this setting is unset. Hover is controlled separately."
        },
        "asm.editorInfo.inline.parts": {
          "scope": "resource",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "description": "Ordered templates for inline information. Omit to use the preset; [] hides all parts. Fields: output_offsets, output_offset_cpu, output_offset_file, output_bytes, output_size, operand_value, operand_values, execution_observations, execution_counts, execution_count_cpu, project_state.FIELD, runtime_state.FIELD. Use ${field}; $${ escapes a literal ${. Missing values omit the whole part. No color or executable expressions."
        },
        "asm.editorInfo.inline.separator": {
          "scope": "resource",
          "type": "string",
          "default": " · ",
          "maxLength": 32,
          "description": "Separator between available inline parts."
        },
        "asm.editorInfo.inline.placement": {
          "scope": "resource",
          "type": "string",
          "enum": [
            "afterLine",
            "aligned"
          ],
          "default": "aligned",
          "description": "Align short lines at the configured column. Longer lines place information after their own source without shifting other overlays. Use afterLine for a three-column gap on every line."
        },
        "asm.editorInfo.inline.column": {
          "scope": "resource",
          "type": "integer",
          "minimum": 0,
          "default": 80,
          "description": "Preferred minimum zero-based column in aligned mode. Honors explicit legacy asm.analysis.annotationColumn when unset."
        },
        "asm.editorInfo.inline.color": {
          "scope": "resource",
          "type": "string",
          "default": "editorCodeLens.foreground",
          "pattern": "^(?:#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})|[A-Za-z][\\w-]*(?:\\.[\\w-]+)+)$",
          "patternErrorMessage": "Enter a hex color such as #FFA65C or a VS Code theme color such as editorWarning.foreground.",
          "description": "Color for the entire inline overlay. Accepts #RGB, #RGBA, #RRGGBB, #RRGGBBAA, or a VS Code theme color identifier (for example editorWarning.foreground). Theme colors follow the active theme."
        },
        "asm.editorInfo.inline.maxCharacters": {
          "scope": "resource",
          "type": "integer",
          "minimum": 24,
          "maximum": 500,
          "default": 120,
          "description": "Total character budget for one source line, including all contexts and truncation marker."
        },
        "asm.editorInfo.hover.enabled": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Append compact source information to hover. Instruction documentation remains unchanged."
        },
        "asm.editorInfo.hover.rows": {
          "scope": "resource",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "description": "Ordered hover-row templates, using the same ${field} placeholders as inline parts. Omit for preset defaults; [] hides analysis rows. Missing fields suppress the entire row."
        }
      }
    },
    "jsonValidation": [],
    "keybindings": [],
    "submenus": [],
    "taskDefinitions": [
      {
        "type": "uttori-source",
        "required": [
          "action",
          "project"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "build"
            ]
          },
          "project": {
            "type": "string",
            "description": "Absolute path of the Git source project."
          }
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "uttori.palette",
        "displayName": "ROM Palette",
        "selector": [
          {
            "filenamePattern": "**/rom-palettes.json"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "uttori.indexedPng",
        "displayName": "Indexed PNG",
        "selector": [
          {
            "filenamePattern": "*.png"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "activationEvents": [],
  "engines": {
    "node": ">=26",
    "vscode": "^1.128.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Built-in assembly support remains available, but workspace plugin modules and uttori-asm.config.json are disabled until the workspace is trusted.",
      "restrictedConfigurations": [
        "asm.configFile",
        "asm.plugins"
      ]
    }
  }
}
