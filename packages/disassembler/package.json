{
  "name": "@uttori/asm-disassembler",
  "version": "1.0.0",
  "description": "ROM identity and persistent analysis-project primitives for Uttori ASM.",
  "keywords": [
    "analysis",
    "disassembler",
    "rom",
    "sqlite"
  ],
  "homepage": "https://github.com/uttori/asm/tree/master/packages/disassembler#readme",
  "bugs": {
    "url": "https://github.com/uttori/asm/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uttori/asm.git",
    "directory": "packages/disassembler"
  },
  "files": [
    "dist",
    "src",
    "*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "uttori-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "uttori-source": "./src/storage.ts",
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./source-project": {
      "uttori-source": "./src/source-project.ts",
      "types": "./dist/source-project.d.ts",
      "import": "./dist/source-project.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "make-types": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepack": "node ../../scripts/clean-workspace-build.ts --workspace disassembler && npm run make-types"
  },
  "dependencies": {
    "@uttori/asm-capture": "1.0.0",
    "@uttori/asm-core": "1.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}
