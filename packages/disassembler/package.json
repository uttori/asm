{
  "name": "@uttori/asm-disassembler",
  "version": "1.0.0",
  "description": "ROM identity and persistent analysis-project primitives for Uttori ASM.",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "uttori-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canonical-json": {
      "uttori-source": "./src/canonical-json.ts",
      "types": "./dist/canonical-json.d.ts",
      "import": "./dist/canonical-json.js",
      "require": "./dist/canonical-json.js"
    }
  },
  "scripts": {
    "make-types": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepack": "node ../../scripts/clean-workspace-build.ts --workspace disassembler && npm run make-types"
  },
  "engines": {
    "node": ">=26"
  }
}
