{
  "name": "@uttori/asm-cli",
  "version": "1.0.0",
  "description": "Command-line interface for Uttori ASM projects.",
  "keywords": [
    "assembler",
    "cli",
    "disassembler",
    "snes"
  ],
  "homepage": "https://github.com/uttori/asm/tree/master/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/uttori/asm/issues"
  },
  "license": "MIT",
  "author": "Matthew Callis <matthew.callis@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/uttori/asm.git",
    "directory": "packages/cli"
  },
  "bin": {
    "uttori-asm": "out/cli.mjs"
  },
  "files": [
    "dist",
    "out",
    "src",
    "*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./out/cli.mjs",
  "module": "./out/cli.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "uttori-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./out/cli.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "cli": "node --conditions=uttori-source --import=tsx src/index.ts",
    "fmt": "oxfmt --config ../../.oxfmtrc.json src tests esbuild.mjs package.json tsconfig.json README.md",
    "fmt:check": "oxfmt --config ../../.oxfmtrc.json --check src tests esbuild.mjs package.json tsconfig.json README.md",
    "lint": "oxlint --config ../../.oxlintrc.json src",
    "lint:fix": "oxlint --config ../../.oxlintrc.json src --fix",
    "make-types": "tsc --project tsconfig.json",
    "pack:check": "npm pack --dry-run",
    "smoke": "node out/cli.mjs --help",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepack": "node ../../scripts/clean-workspace-build.ts --workspace cli && npm run make-types && npm run build"
  },
  "dependencies": {
    "@uttori/asm-assets": "1.0.0",
    "@uttori/asm-core": "1.0.0",
    "@uttori/asm-disassembler": "1.0.0",
    "@uttori/asm-plugin-65xx": "1.0.0",
    "@uttori/asm-plugin-loader-node": "1.0.0",
    "@uttori/asm-plugin-snes": "1.0.0",
    "@uttori/asm-workflows": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@uttori/asm-game-secret-of-mana": "1.0.0",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=26"
  }
}
