{
  "name": "@uttori/asm-plugin-snes",
  "version": "1.0.0",
  "description": "SNES, 65816, SPC700, Super FX, and Asar compatibility plugin for Uttori ASM.",
  "keywords": [
    "65816",
    "assembler",
    "snes",
    "spc700",
    "superfx"
  ],
  "homepage": "https://github.com/uttori/asm/tree/master/packages/plugin-snes#readme",
  "bugs": {
    "url": "https://github.com/uttori/asm/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uttori/asm.git",
    "directory": "packages/plugin-snes"
  },
  "files": [
    "dist",
    "src",
    "*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "uttori-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "make-types": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.build.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepack": "node ../../scripts/clean-workspace-build.ts --workspace plugin-snes && npm run make-types"
  },
  "dependencies": {
    "@uttori/asm-core": "1.0.0",
    "@uttori/asm-disassembler": "1.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}
