{
  "name": "@uttori/asm-plugin-snes",
  "version": "1.0.0",
  "description": "SNES, 65816, SPC700, Super FX, and Asar compatibility plugin for Uttori ASM.",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "uttori-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "make-types": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepack": "node ../../scripts/clean-workspace-build.ts --workspace plugin-snes && npm run make-types"
  },
  "dependencies": {
    "@uttori/asm-core": "1.0.0",
    "@uttori/asm-disassembler": "1.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}
