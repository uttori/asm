{
  "name": "@uttori/asm-game-secret-of-mana",
  "version": "1.0.0",
  "private": true,
  "description": "Private Secret of Mana assembly and authoring integration.",
  "keywords": [
    "assembler",
    "cli",
    "disassembler",
    "snes"
  ],
  "homepage": "https://github.com/uttori/asm/tree/master/packages/game-secret-of-mana#readme",
  "bugs": {
    "url": "https://github.com/uttori/asm/issues"
  },
  "license": "MIT",
  "author": "Matthew Callis <matthew.callis@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/uttori/asm.git",
    "directory": "packages/game-secret-of-mana"
  },
  "files": [
    "dist",
    "src",
    "*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/assembly.js",
  "module": "./dist/assembly.js",
  "types": "./dist/assembly.d.ts",
  "exports": {
    ".": {
      "uttori-source": "./src/assembly.ts",
      "types": "./dist/assembly.d.ts",
      "import": "./dist/assembly.js"
    },
    "./workflows": {
      "uttori-source": "./src/workflows.ts",
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js"
    },
    "./source-adapter": {
      "uttori-source": "./src/source-adapter.ts",
      "types": "./dist/source-adapter.d.ts",
      "import": "./dist/source-adapter.js"
    },
    "./sprite-adapter": {
      "uttori-source": "./src/sprite-adapter.ts",
      "types": "./dist/sprite-adapter.d.ts",
      "import": "./dist/sprite-adapter.js"
    },
    "./room-adapter": {
      "uttori-source": "./src/room-adapter.ts",
      "types": "./dist/room-adapter.d.ts",
      "import": "./dist/room-adapter.js"
    },
    "./preview": {
      "uttori-source": "./src/preview.ts",
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    },
    "./source-host": {
      "uttori-source": "./src/source-host.ts",
      "types": "./dist/source-host.d.ts",
      "import": "./dist/source-host.js"
    }
  },
  "scripts": {
    "make-types": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepack": "node ../../scripts/clean-workspace-build.ts --workspace game-secret-of-mana && npm run make-types"
  },
  "dependencies": {
    "@uttori/asm-assets": "1.0.0",
    "@uttori/asm-core": "1.0.0",
    "@uttori/asm-disassembler": "1.0.0",
    "@uttori/asm-workflows": "1.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}
