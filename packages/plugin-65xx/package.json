{
  "name": "@uttori/asm-plugin-65xx",
  "version": "1.0.0",
  "description": "6502-family architectures and raw binary targets for Uttori ASM.",
  "keywords": [
    "6502",
    "65c02",
    "assembler",
    "nes"
  ],
  "homepage": "https://github.com/uttori/asm/tree/master/packages/plugin-65xx#readme",
  "bugs": {
    "url": "https://github.com/uttori/asm/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uttori/asm.git",
    "directory": "packages/plugin-65xx"
  },
  "files": [
    "dist",
    "src",
    "THIRD_PARTY_NOTICES.md",
    "*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "uttori-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./disassembler": {
      "uttori-source": "./src/disassembler.ts",
      "types": "./dist/disassembler.d.ts",
      "import": "./dist/disassembler.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "make-types": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepack": "node ../../scripts/clean-workspace-build.ts --workspace plugin-65xx && npm run make-types"
  },
  "dependencies": {
    "@uttori/asm-assets": "1.0.0",
    "@uttori/asm-capture": "1.0.0",
    "@uttori/asm-core": "1.0.0",
    "@uttori/asm-disassembler": "1.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}
