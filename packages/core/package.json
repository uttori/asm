{
  "name": "@uttori/asm-core",
  "version": "1.0.0",
  "description": "Architecture-neutral assembler core and plugin API.",
  "keywords": [
    "assembler",
    "assembly",
    "plugin",
    "typescript"
  ],
  "homepage": "https://github.com/uttori/asm/tree/master/packages/core#readme",
  "bugs": {
    "url": "https://github.com/uttori/asm/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uttori/asm.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./src/browser.ts",
      "uttori-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canonical-json": {
      "uttori-source": "./src/canonical-json.ts",
      "types": "./dist/canonical-json.d.ts",
      "import": "./dist/canonical-json.js"
    },
    "./debug-map": {
      "uttori-source": "./src/debug-map.ts",
      "types": "./dist/debug-map.d.ts",
      "import": "./dist/debug-map.js"
    },
    "./plugin": {
      "uttori-source": "./src/plugin/index.ts",
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "make-types": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepack": "node ../../scripts/clean-workspace-build.ts --workspace core && npm run make-types"
  },
  "dependencies": {
    "@uttori/data-tools": "^5",
    "semver": "^7.8.5"
  },
  "engines": {
    "node": ">=26"
  }
}
