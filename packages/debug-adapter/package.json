{
  "name": "@uttori/asm-debug-adapter",
  "version": "1.0.0",
  "description": "Emulator-neutral debugger backend contract and Debug Adapter Protocol bridge for Uttori ASM.",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "make-types": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@uttori/asm-core": "1.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}
