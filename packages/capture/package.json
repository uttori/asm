{
  "name": "@uttori/asm-capture",
  "version": "1.0.0",
  "description": "ACT2 archive contracts, bounded readers, recovery and target payload codecs.",
  "keywords": [
    "act2",
    "capture",
    "emulator"
  ],
  "homepage": "https://github.com/uttori/asm/tree/master/packages/capture#readme",
  "bugs": {
    "url": "https://github.com/uttori/asm/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uttori/asm.git",
    "directory": "packages/capture"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "uttori-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "make-types": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepack": "node ../../scripts/clean-workspace-build.ts --workspace capture && npm run make-types"
  },
  "dependencies": {
    "@uttori/data-tools": "^5"
  },
  "engines": {
    "node": ">=26"
  }
}
