From 91350293ac560ceff449ff263d05ba849e2352f2 Mon Sep 17 00:00:00 2001
From: Matthew Callis <matthew.callis@gmail.com>
Date: Mon, 7 Sep 2026 12:56:36 -0700
Subject: [PATCH] Fix macOS build when show-sdk-platform-version fails

(cherry picked from commit a1f6e6bd8fdbf2d1f250bff37b8dd81fddac3890)
---
 cmake/macos/compilerconfig.cmake | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/cmake/macos/compilerconfig.cmake b/cmake/macos/compilerconfig.cmake
index f0370455a..77f968fa6 100644
--- a/cmake/macos/compilerconfig.cmake
+++ b/cmake/macos/compilerconfig.cmake
@@ -30,6 +30,15 @@ function(check_sdk_requirements)
     RESULT_VARIABLE result
     OUTPUT_STRIP_TRAILING_WHITESPACE
   )
+  # Fallback when --show-sdk-platform-version fails but the SDK is installed
+  if(NOT result EQUAL 0)
+    execute_process(
+      COMMAND xcrun --sdk macosx --show-sdk-version
+      OUTPUT_VARIABLE ares_macos_current_sdk
+      RESULT_VARIABLE result
+      OUTPUT_STRIP_TRAILING_WHITESPACE
+    )
+  endif()
   if(NOT result EQUAL 0)
     message(
       FATAL_ERROR
