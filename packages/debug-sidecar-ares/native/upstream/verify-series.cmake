cmake_minimum_required(VERSION 3.28)

function(run_git result checkout)
  execute_process(
    COMMAND git -C "${checkout}" ${ARGN}
    RESULT_VARIABLE status
    OUTPUT_VARIABLE output
    ERROR_VARIABLE error
    OUTPUT_STRIP_TRAILING_WHITESPACE
  )
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "git ${ARGN}: ${error}${output}")
  endif()
  set(${result} "${output}" PARENT_SCOPE)
endfunction()

file(READ "${SERIES_DIR}/series.json" manifest)
string(JSON version GET "${manifest}" schemaVersion)
if(NOT version EQUAL 1)
  message(FATAL_ERROR "Unsupported series manifest")
endif()
string(JSON integration GET "${manifest}" integrationRevision)
string(JSON previous GET "${manifest}" upstreamRevision)
run_git(head "${REPO}" rev-parse HEAD)
run_git(status "${REPO}" status --porcelain --untracked-files=all)
if(NOT head STREQUAL integration OR NOT status STREQUAL "")
  message(FATAL_ERROR "Expected a clean checkout at ${integration}; got ${head}: ${status}")
endif()
run_git(ignored "${REPO}" worktree add --detach "${VERIFY_WORKTREE}" "${previous}")

string(JSON count LENGTH "${manifest}" layers)
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
  foreach(key id base head patch sha256)
    string(JSON ${key} GET "${manifest}" layers ${index} ${key})
  endforeach()
  run_git(parent "${REPO}" rev-parse "${head}^")
  if(NOT base STREQUAL previous OR NOT parent STREQUAL base)
    message(FATAL_ERROR "${id}: parent/base mismatch")
  endif()
  file(SHA256 "${SERIES_DIR}/${patch}" actual_hash)
  if(NOT actual_hash STREQUAL sha256)
    message(FATAL_ERROR "${id}: patch digest mismatch")
  endif()
  set(expected_files "")
  string(JSON count_files LENGTH "${manifest}" layers ${index} files)
  math(EXPR last_file "${count_files} - 1")
  foreach(file_index RANGE ${last_file})
    string(JSON file_path GET "${manifest}" layers ${index} files ${file_index} path)
    string(JSON expected_hash GET "${manifest}" layers ${index} files ${file_index} sha256)
    if(file_path MATCHES "^headless/")
      message(FATAL_ERROR "${id}: alternate executable target in desktop series")
    endif()
    string(APPEND expected_files "${file_path}\n")
    execute_process(
      COMMAND git -C "${REPO}" show "${head}:${file_path}"
      OUTPUT_FILE "${VERIFY_WORKTREE}/.git-verify-blob"
      COMMAND_ERROR_IS_FATAL ANY
    )
    file(SHA256 "${VERIFY_WORKTREE}/.git-verify-blob" actual_hash)
    file(REMOVE "${VERIFY_WORKTREE}/.git-verify-blob")
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "${id}: ${file_path} digest mismatch")
    endif()
  endforeach()
  string(STRIP "${expected_files}" expected_files)
  run_git(actual_files "${REPO}" diff --name-only "${base}" "${head}")
  if(NOT actual_files STREQUAL expected_files)
    message(FATAL_ERROR "${id}: changed-file boundary mismatch")
  endif()
  run_git(ignored "${VERIFY_WORKTREE}" apply --check --whitespace=nowarn --index "${SERIES_DIR}/${patch}")
  run_git(ignored "${VERIFY_WORKTREE}" apply --whitespace=nowarn --index "${SERIES_DIR}/${patch}")
  # Verify the complete intermediate tree, not only the listed files.
  run_git(ignored "${VERIFY_WORKTREE}" diff --cached --exit-code "${head}")
  set(previous "${head}")
  message(STATUS "PASS ${id}: digest, exact files, clean apply, complete tree identity")
endforeach()
if(NOT previous STREQUAL integration)
  message(FATAL_ERROR "Series does not end at the integration revision")
endif()
run_git(ignored "${VERIFY_WORKTREE}" diff --exit-code)

# Independently verify the follow-up against the submitted U2 head, using only this disposable tree.
foreach(key base head patch sha256)
  string(JSON followup_${key} GET "${manifest}" pollingTestFollowUp ${key})
endforeach()
run_git(parent "${REPO}" rev-parse "${followup_head}^")
file(SHA256 "${SERIES_DIR}/${followup_patch}" followup_actual_hash)
if(NOT parent STREQUAL followup_base OR NOT followup_actual_hash STREQUAL followup_sha256)
  message(FATAL_ERROR "U2 standalone follow-up identity mismatch")
endif()
run_git(ignored "${VERIFY_WORKTREE}" reset --hard "${followup_base}")
run_git(ignored "${VERIFY_WORKTREE}" apply --check --whitespace=nowarn --index "${SERIES_DIR}/${followup_patch}")
run_git(ignored "${VERIFY_WORKTREE}" apply --whitespace=nowarn --index "${SERIES_DIR}/${followup_patch}")
run_git(ignored "${VERIFY_WORKTREE}" diff --cached --exit-code "${followup_head}")
message(STATUS "PASS U2 standalone follow-up: submitted base, digest, clean apply, complete tree identity")
