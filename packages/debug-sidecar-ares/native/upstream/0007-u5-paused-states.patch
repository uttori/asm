From f167edfc62b72101c873b6175855171ac5b093f8 Mon Sep 17 00:00:00 2001
From: Matthew Callis <matthew.callis@gmail.com>
Date: Tue, 8 Sep 2026 23:21:15 -0700
Subject: [PATCH] sfc: synchronize save states while halted in GDB

---
 ares/sfc/cpu/cpu.cpp              |   7 +-
 ares/sfc/cpu/memory.cpp           |   6 +-
 ares/sfc/system/serialization.cpp |   5 ++
 tests/gdb/CMakeLists.txt          |  15 +++-
 tests/gdb/README.md               |  11 ++-
 tests/gdb/gdb-boundaries.cpp      |   2 +
 tests/gdb/gdb-memory-packets.cpp  |   2 +
 tests/gdb/gdb-registers.cpp       |   2 +
 tests/gdb/gdb-states.cpp          | 140 ++++++++++++++++++++++++++++++
 tests/gdb/gdb-storage.cpp         |   2 +
 tests/gdb/run-tests.sh            |   2 +-
 11 files changed, 187 insertions(+), 7 deletions(-)
 create mode 100644 tests/gdb/gdb-states.cpp

diff --git a/ares/sfc/cpu/cpu.cpp b/ares/sfc/cpu/cpu.cpp
index 68e04412b..f73411e9f 100644
--- a/ares/sfc/cpu/cpu.cpp
+++ b/ares/sfc/cpu/cpu.cpp
@@ -33,7 +33,12 @@ auto CPU::main() -> void {
 
   if(!status.interruptPending) {
     // Yield to the desktop worker while halted so its UI/quit guard remains live.
-    while(!nall::GDB::server.reportPC(r.pc.d)) scheduler.exit(Event::Step);
+    while(!nall::GDB::server.reportPC(r.pc.d)) {
+      scheduler.exit(Event::Step);
+      // A save (including the undo snapshot before loading) may resume us here.
+      // This instruction boundary is safe to serialize without advancing the CPU.
+      scheduler.synchronize();
+    }
     debugger.instruction();
     return instruction();
   }
diff --git a/ares/sfc/cpu/memory.cpp b/ares/sfc/cpu/memory.cpp
index bdbd6fb0c..25f02f3c2 100644
--- a/ares/sfc/cpu/memory.cpp
+++ b/ares/sfc/cpu/memory.cpp
@@ -2,7 +2,11 @@ auto CPU::idle() -> void {
   // WAI/STP loop inside the processor core and may never return to CPU::main.
   // Stop at an idle boundary without treating the following PC as executed.
   if(r.wai || r.stp) {
-    while(!nall::GDB::server.reportPC(r.pc.d, false)) scheduler.exit(Event::Step);
+    while(!nall::GDB::server.reportPC(r.pc.d, false)) {
+      scheduler.exit(Event::Step);
+      // WAI/STP state can be restored at this idle boundary, before any bus work.
+      scheduler.synchronize();
+    }
   }
   status.clockCount = 6;
   dmaEdge();
diff --git a/ares/sfc/system/serialization.cpp b/ares/sfc/system/serialization.cpp
index 2eee447ac..633b488e8 100644
--- a/ares/sfc/system/serialization.cpp
+++ b/ares/sfc/system/serialization.cpp
@@ -38,6 +38,11 @@ auto System::unserialize(serializer& s) -> bool {
 
   if(synchronize) power(/* reset = */ false);
   serialize(s, synchronize);
+  // Keep the acknowledged stop at the restored boundary. Otherwise stepping
+  // from a loaded breakpoint compares against the PC from before the load.
+  if(synchronize && nall::GDB::server.isHalted()) {
+    nall::GDB::server.reportPC(cpu.r.pc.d, !cpu.r.wai && !cpu.r.stp);
+  }
   return true;
 }
 
