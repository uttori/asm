index a3d2a3a93..18ee4d9e7 100644
--- a/tests/gdb/CMakeLists.txt
+++ b/tests/gdb/CMakeLists.txt
@@ -3,13 +3,13 @@ if(NOT sfc IN_LIST ARES_CORES)
   return()
 endif()
 
-set(gdb_targets gdb-registers gdb-memory-packets gdb-storage gdb-boundaries)
+set(gdb_targets gdb-registers gdb-memory-packets gdb-storage gdb-boundaries gdb-states)
 foreach(target IN LISTS gdb_targets)
   add_executable(${target} ${target}.cpp)
   target_include_directories(${target} PRIVATE ${CMAKE_SOURCE_DIR} ${CMAKE_SOURCE_DIR}/ares)
   target_link_libraries(${target} PRIVATE ares::nall)
-  # Inspect protocol state only in the test translation unit. Keep assertions in release builds.
-  target_compile_options(${target} PRIVATE -fno-access-control -UNDEBUG)
+  # Inspect protocol state only in the test translation unit.
+  target_compile_options(${target} PRIVATE -fno-access-control)
   set_target_properties(${target} PROPERTIES FOLDER tests PREFIX "")
   set(CONSOLE TRUE)
   ares_configure_executable(${target})
@@ -19,6 +19,15 @@ foreach(target IN LISTS gdb_targets)
 endforeach()
 
 target_link_libraries(gdb-storage PRIVATE ares::ares)
+target_link_libraries(gdb-states PRIVATE ares::ares)
+foreach(mode IN ITEMS wai stp)
+  add_test(NAME gdb-states-${mode} COMMAND gdb-states ${mode})
+  set_tests_properties(gdb-states-${mode} PROPERTIES TIMEOUT 10)
+endforeach()
+foreach(mode IN ITEMS instruction wai stp)
+  add_test(NAME gdb-states-${mode}-accurate COMMAND gdb-states ${mode} accurate)
+  set_tests_properties(gdb-states-${mode}-accurate PROPERTIES TIMEOUT 10)
+endforeach()
 add_custom_target(gdb-tests DEPENDS ${gdb_targets})
 target_sources(gdb-tests PRIVATE run-tests.sh README.md)
 target_enable_subproject(gdb-tests "GDB register, storage, and lifecycle tests")
diff --git a/tests/gdb/README.md b/tests/gdb/README.md
index 6a0bcd0c6..a6d481e90 100644
--- a/tests/gdb/README.md
+++ b/tests/gdb/README.md
@@ -23,9 +23,18 @@ paths, platform libraries, and the core profile come from the normal ares build.
   exclusion, cartridge RAM offsets, remap/unmap, and physical storage bounds.
 - `gdb-boundaries` checks deferred stop/reset responses, stepping off breakpoints,
   quiescent stops, disconnect/reconnect, and legacy-core behavior.
+- `gdb-states` links the real SFC core and exercises synchronized save, the undo
+  snapshot taken before loading, load, undo load, and stepping from a restored
+  breakpoint. Instruction, WAI, and STP stops run with both PPU implementations.
+  Save/load callbacks run on a separate thread while the emulation thread is
+  idle, matching the desktop's guarded handoff. CPU clocks and registers must
+  remain unchanged during each snapshot, and no duplicate stop packet is sent.
+  A bounded scheduler-event guard makes the original hang fail immediately;
+  CTest also imposes a ten-second timeout.
 
 Only the test translation units use `-fno-access-control` to inspect protocol
-state; assertions remain enabled in release builds with `-UNDEBUG`. The ares
+state. Each test undefines `NDEBUG` after including nall and before `<cassert>`:
+nall's build-mode header otherwise redefines it despite `-UNDEBUG`. The ares
 Clang/GCC toolchains are supported. This preparation was run on macOS arm64;
 Linux/Windows execution remains before runtime promotion.
 
