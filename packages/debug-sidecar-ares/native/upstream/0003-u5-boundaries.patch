From 27003f0ec701f1174169e5d215e221fc045f36d3 Mon Sep 17 00:00:00 2001
From: Matthew Callis <matthew.callis@gmail.com>
Date: Tue, 8 Sep 2026 11:22:35 -0700
Subject: [PATCH] sfc: stop the desktop debugger at coherent CPU and idle
 boundaries

---
 ares/sfc/cpu/cpu.cpp           |  3 ++
 ares/sfc/cpu/memory.cpp        |  5 +++
 ares/sfc/system/gdb.cpp        |  2 +
 desktop-ui/program/load.cpp    | 12 +++---
 desktop-ui/program/program.cpp | 18 +++++++-
 desktop-ui/program/program.hpp |  1 +
 nall/nall/gdb/server.cpp       | 57 +++++++++++++++++++++++---
 nall/nall/gdb/server.hpp       |  8 +++-
 tests/gdb/CMakeLists.txt       |  2 +-
 tests/gdb/README.md            |  8 ++++
 tests/gdb/gdb-boundaries.cpp   | 75 ++++++++++++++++++++++++++++++++++
 11 files changed, 176 insertions(+), 15 deletions(-)
 create mode 100644 tests/gdb/gdb-boundaries.cpp

diff --git a/ares/sfc/cpu/cpu.cpp b/ares/sfc/cpu/cpu.cpp
index 4f0fc176f..68e04412b 100644
--- a/ares/sfc/cpu/cpu.cpp
+++ b/ares/sfc/cpu/cpu.cpp
@@ -1,4 +1,5 @@
 #include <sfc/sfc.hpp>
+#include <nall/gdb/server.hpp>
 
 namespace ares::SuperFamicom {
 
@@ -31,6 +32,8 @@ auto CPU::main() -> void {
   if(r.stp) return instructionStop();
 
   if(!status.interruptPending) {
+    // Yield to the desktop worker while halted so its UI/quit guard remains live.
+    while(!nall::GDB::server.reportPC(r.pc.d)) scheduler.exit(Event::Step);
     debugger.instruction();
     return instruction();
   }
diff --git a/ares/sfc/cpu/memory.cpp b/ares/sfc/cpu/memory.cpp
index d42401e8d..bdbd6fb0c 100644
--- a/ares/sfc/cpu/memory.cpp
+++ b/ares/sfc/cpu/memory.cpp
@@ -1,4 +1,9 @@
 auto CPU::idle() -> void {
+  // WAI/STP loop inside the processor core and may never return to CPU::main.
+  // Stop at an idle boundary without treating the following PC as executed.
+  if(r.wai || r.stp) {
+    while(!nall::GDB::server.reportPC(r.pc.d, false)) scheduler.exit(Event::Step);
+  }
   status.clockCount = 6;
   dmaEdge();
   step(6);
diff --git a/ares/sfc/system/gdb.cpp b/ares/sfc/system/gdb.cpp
index b5ef63c2e..ff9d8e75b 100644
--- a/ares/sfc/system/gdb.cpp
+++ b/ares/sfc/system/gdb.cpp
@@ -21,6 +21,8 @@ auto normalizeGdbRegisters() -> void {
 
 auto installGdbHooks() -> void {
   using nall::GDB::server;
+  server.hooks.instructionBoundaryStop = true;
+  server.hooks.emuReset = [] { system.power(true); };
   server.hooks.registersLittleEndian = true;
   server.hooks.targetXML = []() -> string {
     return "<target version=\"1.0\">"
diff --git a/desktop-ui/program/load.cpp b/desktop-ui/program/load.cpp
index 2aaf4e122..49cb5410b 100644
--- a/desktop-ui/program/load.cpp
+++ b/desktop-ui/program/load.cpp
@@ -121,12 +121,13 @@ auto Program::load(string location) -> bool {
     tapeViewer.reload();
   }
   state = {};  //reset hotkey state slot to 1
