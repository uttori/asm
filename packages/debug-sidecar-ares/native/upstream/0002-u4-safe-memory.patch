diff --git a/ares/sfc/system/gdb-memory.cpp b/ares/sfc/system/gdb-memory.cpp
new file mode 100644
index 000000000..0fa7f662b
--- /dev/null
+++ b/ares/sfc/system/gdb-memory.cpp
@@ -0,0 +1,16 @@
+namespace {
+auto installGdbMemoryHooks() -> void {
+  nall::GDB::server.hooks.read = [](u64 address, u32 size) -> string {
+    // RSP m reads are exact. Do not alias invalid addresses or synthesize MMIO.
+    if(address > 0xff'ffff || size > 0x100'0000 - address || size > 0x2000) return "E00";
+    string result;
+    result.reserve(size * 2);
+    for(u32 byte : range(size)) {
+      auto value = bus.peek(address + byte);
+      if(!value) return "E00";
+      result.append(hex(value.get(), 2, '0'));
+    }
+    return result;
+  };
+}
+}
