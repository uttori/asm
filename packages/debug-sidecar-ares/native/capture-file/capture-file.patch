+  auto nativeChunk(size_t index) -> const Chunk* {
+    if(index >= size) return nullptr;
+    auto& chunk = queue[(head + index) % queue.size()];
+    if(!chunk.sealed) {
+      if(pending && !busOnly) return nullptr;
+      seal(chunk);
+    }
+    delivered = std::max(delivered, chunk.first + chunk.count - 1);
+    return &chunk;
