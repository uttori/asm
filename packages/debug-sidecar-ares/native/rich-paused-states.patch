diff --git a/ares/sfc/cpu/cpu.cpp b/ares/sfc/cpu/cpu.cpp
index 622282a9..40b99148 100644
--- a/ares/sfc/cpu/cpu.cpp
+++ b/ares/sfc/cpu/cpu.cpp
@@ -36,6 +36,9 @@ auto CPU::main() -> void {
       // Preserve the instruction boundary, but let the frontend service its
       // UI/quit/settings guard while stopped. It owns the RSP polling loop.
       scheduler.exit(Event::Step);
+      // Save/load enters here to create a synchronized undo snapshot. Stay at
+      // the stopped instruction instead of blocking until the client times out.
+      scheduler.synchronize();
     }
     auto& trace = nall::GDB::server;
     if(trace.detailedTraceActive()) {
diff --git a/ares/sfc/system/serialization.cpp b/ares/sfc/system/serialization.cpp
index 2eee447a..7aa9dce0 100644
--- a/ares/sfc/system/serialization.cpp
+++ b/ares/sfc/system/serialization.cpp
@@ -38,6 +38,10 @@ auto System::unserialize(serializer& s) -> bool {
 
   if(synchronize) power(/* reset = */ false);
   serialize(s, synchronize);
+  if(synchronize && nall::GDB::server.isHalted()) {
+    // Refresh the acknowledged stop without disconnecting or resuming it.
+    nall::GDB::server.reportPC(cpu.r.pc.d);
+  }
   return true;
 }
 
