{
  "name": "@uttori/asm-debug-sidecar-ares",
  "version": "1.0.0",
  "description": "Restartable ares debugger sidecar for Uttori ASM.",
  "keywords": [
    "ares",
    "debugger",
    "sidecar",
    "snes"
  ],
  "homepage": "https://github.com/uttori/asm/tree/master/packages/debug-sidecar-ares#readme",
  "bugs": {
    "url": "https://github.com/uttori/asm/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uttori/asm.git",
    "directory": "packages/debug-sidecar-ares"
  },
  "bin": {
    "uttori-asm-debug-sidecar-ares": "out/sidecar.mjs"
  },
  "files": [
    "dist",
    "out",
    "src",
    "README.md",
    "*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "uttori-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./profile": {
      "uttori-source": "./src/profile.ts",
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js"
    },
    "./runtime-manifest": {
      "uttori-source": "./src/ares-process-host.ts",
      "types": "./dist/ares-process-host.d.ts",
      "import": "./dist/ares-process-host.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "make-types": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "smoke": "node out/sidecar.mjs --help",
    "desktop-rsp:check": "tsc -p tests/desktop-rsp/tsconfig.json && oxlint tests/desktop-rsp/*.mjs && oxfmt --check tests/desktop-rsp",
    "prepack": "node ../../scripts/clean-workspace-build.ts --workspace debug-sidecar-ares && npm run make-types && npm run build"
  },
  "dependencies": {
    "@uttori/asm-capture": "1.0.0",
    "@uttori/asm-core": "1.0.0",
    "@uttori/asm-debug-adapter": "1.0.0",
    "@uttori/asm-plugin-65xx": "1.0.0",
    "@uttori/asm-plugin-snes": "1.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=26"
  }
}
