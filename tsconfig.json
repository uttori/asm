{
  "include": [
    "src",
    "tests/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "extendedDiagnostics": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "noEmit": false,
    "sourceMap": true,
    "strict": true,
    "target": "esnext",
    "types": ["debug", "node", "sinon"],
    "removeComments": false,
    "skipLibCheck": true,
    "declarationMap": true
  }
}
