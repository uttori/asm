decompressData
    php

    rep #$30
    sep #$20

    ldx.w #$0000
    ldy.b sourceOffset

decompressLoop
    cpx.b decompressLength ; end of decompression
    beq checkForSecondPass
    bcc continueDecompression

checkForSecondPass
    rep #$20        ; check for even/odd comression
    txa
    and.w #$0001
    sep #$20
    beq decompressSecondPass ; if just done even compression, now do odd

    plp

    rts

decompressSecondPass
    ldx.w #$0001

continueDecompression
    lda [sourcePointer],y ; get code
    iny             ; update index, check for crossing bank boundary
    bne noWrap1
    ldy.b sourcePointer+$02
    iny
    sty.b sourcePointer+$02
    ldy.w #$8000
noWrap1

    bit #$80        ; if bit 7 clear
    beq doRepeatString ; then decompress a repeat string

doCollectionString
    and #$7F        ; get collection count
    sta.b collectCount

expandCollectionString
    lda [sourcePointer],y ; get byte
    iny             ; update index, check for crossing bank boundary
    bne noWrap2
    ldy.b sourcePointer+$02
    iny
    sty.b sourcePointer+$02
    ldy.w #$8000
noWrap2

    sta.l $7F0000,x ; store byte in RAM
    inx
    inx

    dec.b collectCount ; repeat for collection count
    bpl expandCollectionString

    bra decompressLoop

doRepeatString
    sta.b repeatCount

    lda [sourcePointer],y ; get byte
    iny             ; update index, check for crossing bank boundary
    bne noWrap3
    ldy.b sourcePointer+$02
    iny
    sty.b sourcePointer+$02
    ldy.w #$8000
noWrap3

expandRepeatString
    sta.l $7F0000,x ; store byte in RAM
    inx
    inx

    dec.b repeatCount ; repeat for repeat count
    bpl expandRepeatString

    bra decompressLoop
