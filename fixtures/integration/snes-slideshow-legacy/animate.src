processAnimationFrame:
    php                                     ; preserve registers
    rep #$30
    ldx.w #$0000                            ; initialise index into animation data

frameColourLoop:
    lda.l $7F0000,x                         ; get word from animation data
    inx
    inx

    cmp.w #$FFFF                            ; check to see if color palette is done by comparing value to FFFF
    beq animationFrameLoop

    sta.b !animatedBytes                    ; set number of colour palette bytes to copy
    sta $4305                               ; then store size of data block

    lda.w #$2200                            ; DMA to $2122
    sta $4300                               ; set DMA mode (word, normal increment)

    sep #$20

    lda.l $7F0000,x                         ; get byte from animation data
    inx
    sta $2121                               ; set colour register

    stx $4302                               ; set source address offset into DMA source offset

    lda #$7F                                ; set source address bank \
    sta $4304                               ;   into DMA source bank

    lda #$01                                ; initiate \
    sta $420B                               ;   DMA transfer (channel 1)

    rep #$20

    txa                                     ; update index into animation data
    clc
    adc.b !animatedBytes
    tax

    bra frameColourLoop                     ; and repeat

animationFrameLoop:
    lda.l $7F0000,x                         ; get next word of animation data
    inx
    inx

    cmp.w #$0000
    bpl continueAnimation

    cmp.w #$FFFF                            ; if the frame is complete
    beq animationFrameComplete

    wai                                     ; otherwise this is an intermediate frame

    bra animationFrameLoop

animationFrameComplete:
    plp                                     ; restore registers
    rts                                     ; return

continueAnimation:
    sta $2116                               ; set VRAM address

    lda.w #$1801                            ; dma to $2118, VRAM Data Write
    sta $4300

    lda.l $7F0000,x                         ; get next word of animation data
    inx
    inx

    sta.b !animatedBytes
    sta $4305                               ; set number of bytes

    stx $4302                               ; set source offset

    sep #$20

    lda #$7F                                ; source bank
    sta $4304

    lda #$01                                ; do dma
    sta $420B

    rep #$20

    txa                                     ; update index into animation data
    clc
    adc.b !animatedBytes
    tax

    bra animationFrameLoop                  ; and repeat
