{
  "extends": "airbnb",
  "plugins": [],
  "env": {
    "browser": true,
    "mocha": true,
    "node": true,
    "es6": true
  },
  "globals": {
    "jest": false,
    "expect": false,
    "beforeAll": false,
    "afterAll": false,
    "jsdom": false
  },
  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true,
      "experimentalObjectRestSpread": true
    }
  },
  "rules": {
    "arrow-parens": 0,
    "arrow-body-style": ["error", "as-needed"],
    "camelcase": 0,
    "class-methods-use-this": 0,
    "max-len": 0,
    "no-console": 0,
    "no-param-reassign": 0,
    "no-unused-expressions": ["error", { "allowTernary": true, "allowShortCircuit": true }],
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "comma-dangle": [
      "error",
      {
        "arrays": "always-multiline",
        "objects": "always-multiline",
        "imports": "ignore",
        "exports": "ignore",
        "functions": "ignore"
      }
    ],
    "function-paren-newline": 0,
    "jsx-a11y/label-has-for": 0,
    "no-return-assign": 0,
    "object-curly-newline": 0,
    "prefer-destructuring": 0,
    "prefer-promise-reject-errors": 0,
    "react/forbid-prop-types": 1,
    "react/jsx-curly-brace-presence": 0,
    "react/require-default-props": 0,
    "no-bitwise": 0,
    "no-plusplus": 0
  }
}
