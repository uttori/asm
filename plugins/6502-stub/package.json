{
  "name": "@uttori/asm-plugin-6502-stub",
  "version": "1.0.0",
  "description": "Deliberately nonfunctional MOS 6502 contract-test plugin for Uttori ASM.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "make-types": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@uttori/asm-core": "1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
